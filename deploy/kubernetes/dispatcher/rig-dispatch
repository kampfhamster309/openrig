#!/usr/bin/env bash
# rig-dispatch: one OpenRig team pod per ticket (stage 1 of docs/proposals/factory-on-kubernetes.md).
#
#   rig-dispatch start   <ticket> --repo <url> --brief-file <file> [options]
#   rig-dispatch status  [<ticket>] [--json]
#   rig-dispatch wait    <ticket> [--timeout <seconds>] [--stall <minutes>]
#   rig-dispatch archive <ticket> [--dir <root>]
#   rig-dispatch collect <ticket> [--archive <dir>] [--into <local git repo>]
#   rig-dispatch answer  <ticket> <qitem> <decision text>
#   rig-dispatch delete  <ticket>
#
# State lives in Kubernetes labels and annotations and in the team pod, so every command can be
# run again. The dispatcher reaches team pods only through `kubectl exec`; inside the pod, `rig`
# talks to its own daemon over loopback.
#
# Environment: KUBECONFIG, KUBECTL (default kubectl), RIG_DISPATCH_NAMESPACE (default openrig),
# RIG_DISPATCH_IMAGE (default: the image pinned in ../kustomization.yaml), RIG_DISPATCH_HUB_POD
# (default hub-0; the hub to register teams with. No Ready hub pod there: registration is skipped).
# Archive: RIG_DISPATCH_ARCHIVE_DIR (default ./tickets, --dir wins), RIG_DISPATCH_QUEUE_LIMIT
# (default 100000 rows of queue history), RIG_DISPATCH_MAX_PAGES (default 200 pages per paged read).
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
NS="${RIG_DISPATCH_NAMESPACE:-openrig}"
KUBECTL="${KUBECTL:-kubectl}"
WORK=/home/openrig/work
RESULT="$WORK/result.json"
ANN=openrig.dev

die() { echo "rig-dispatch: $*" >&2; exit 1; }
log() { echo "[rig-dispatch] $*" >&2; }
k() { "$KUBECTL" -n "$NS" "$@"; }
need() { command -v "$1" >/dev/null || die "$1 is required"; }
need jq; need "$KUBECTL"

usage() { sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }

# PROJ-123 -> proj-123: a DNS label that is also a valid OpenRig host id (no dots).
slug_of() {
  local s
  s=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9-]+/-/g; s/^-+//; s/-+$//' | cut -c1-40)
  s=${s%-}
  [ -n "$s" ] || die "ticket '$1' gives an empty name"
  printf '%s' "$s"
}

name_of() { printf 't-%s' "$1"; }
pod_of() { printf 't-%s-0' "$1"; }
inpod() { local slug=$1; shift; k exec -i "$(pod_of "$slug")" -c daemon -- "$@"; }
sts_json() { k get statefulset "$(name_of "$1")" -o json 2>/dev/null; }
annotation() { jq -r --arg k "$ANN/$2" '.metadata.annotations[$k] // empty' <<<"$1"; }
annotate() { k annotate --overwrite statefulset "$(name_of "$1")" "$ANN/$2=$3" >/dev/null; }

default_image() {
  local kz="$HERE/../kustomization.yaml"
  [ -f "$kz" ] || die "set RIG_DISPATCH_IMAGE"
  awk '/newName:/{n=$2} /newTag:/{t=$2} END{if(n&&t) print n":"t}' "$kz"
}

# --- hub (stage 2) -------------------------------------------------------------------------------
#
# The hub (../hub) is an OpenRig daemon with no rigs whose hosts.yaml lists every team pod, so one
# TUI shows every team at once. The dispatcher keeps it in step: `start` registers a team once its
# pod is Ready, `delete` unregisters it. With no Ready hub pod in the namespace every helper here is
# a no-op and the dispatcher behaves exactly as it did in stage 1.

HUB_POD="${RIG_DISPATCH_HUB_POD:-hub-0}"
_hub_npm_root=""

hub_ready() {
  "$KUBECTL" -n "$NS" get pod "$HUB_POD" -o json 2>/dev/null |
    jq -e 'any(.status.conditions[]?; .type == "Ready" and .status == "True")' >/dev/null 2>&1
}

hub_exec() { "$KUBECTL" -n "$NS" exec -i "$HUB_POD" -c daemon -- "$@"; }

# What the hub dials. A bearer is required: the team pod binds 0.0.0.0, and sending one also
# satisfies the daemon's Host-header check, so the teams need no OPENRIG_ALLOWED_HOSTS.
hub_host_url() { printf 'http://%s.teams.%s.svc:7433' "$(pod_of "$1")" "$NS"; }
hub_bearer_file() { printf '/home/openrig/.openrig/hosts.d/%s.bearer' "$(name_of "$1")"; }
team_bearer() { k get secret "$(name_of "$1")" -o jsonpath='{.data.bearer}' | base64 -d; }

# The hub image has no PyYAML. The CLI's own `yaml` dependency is the same parser `rig host add`
# writes with, so the registry is edited with it.
hub_npm_root() {
  # </dev/null matters: this is often called while a pipeline has stdin open, and
  # `kubectl exec -i` would otherwise read the script meant for the next command.
  [ -n "$_hub_npm_root" ] || _hub_npm_root=$(hub_exec sh -c 'npm root -g' </dev/null 2>/dev/null | tail -n1)
  printf '%s' "$_hub_npm_root"
}

# There is no `rig host remove`, so hosts.yaml is edited directly, and host-bindings.json (the
# trust-on-first-use alias sidecar) is cleaned in the same pass:
#   HUB_MODE=has    exit 0 if HUB_HOST_ID is registered, 1 if it is not
#   HUB_MODE=remove drop that entry and its alias, rewriting each file via tmp + rename at 0600
hub_registry() {
  local mode=$1 host=$2 root
  root=$(hub_npm_root)
  printf '%s\n' '
const fs = require("fs"), path = require("path");
const home = process.env.OPENRIG_HOME || process.env.HOME + "/.openrig";
const yamlFile = path.join(home, "hosts.yaml");
const bindFile = path.join(home, "host-bindings.json");
const mode = process.env.HUB_MODE, id = process.env.HUB_HOST_ID;
function loadYaml() {
  const r = process.env.NPM_ROOT;
  if (r) { try { return require(path.join(r, "@openrig/cli/node_modules/yaml")); } catch (e) {}
  }
  return require("yaml");
}
// tmp + rename, as the CLI does. The daemon re-reads hosts.yaml on every request, so an
// in-place truncate could be observed half written.
function writeAtomic(file, text) {
  const tmp = file + ".tmp-" + process.pid;
  fs.writeFileSync(tmp, text, { mode: 0o600 });
  fs.renameSync(tmp, file);
}
if (!fs.existsSync(yamlFile)) process.exit(mode === "has" ? 1 : 0);
const YAML = loadYaml();
const doc = YAML.parse(fs.readFileSync(yamlFile, "utf8")) || {};
const hosts = Array.isArray(doc.hosts) ? doc.hosts : [];
if (mode === "has") process.exit(hosts.some((h) => h && h.id === id) ? 0 : 1);
const kept = hosts.filter((h) => !(h && h.id === id));
if (kept.length !== hosts.length) {
  doc.hosts = kept;
  writeAtomic(yamlFile, YAML.stringify(doc));
}
// A leftover alias is harmless - a re-dispatched slug presents the same self-id - but it is
// residue, and "the hub forgot the team" should mean the hub forgot the team.
try {
  const b = JSON.parse(fs.readFileSync(bindFile, "utf8"));
  if (b && b.bindings) {
    let n = 0;
    for (const [k, v] of Object.entries(b.bindings)) {
      if (k === id || (v && v.hostId === id)) { delete b.bindings[k]; n++; }
    }
    if (n > 0) writeAtomic(bindFile, JSON.stringify(b, null, 2) + "\n");
  }
} catch (e) { /* no sidecar, or unreadable: nothing to clean */ }
console.log(kept.length === hosts.length ? "absent" : "removed " + id);
' | hub_exec env NPM_ROOT="$root" HUB_MODE="$mode" HUB_HOST_ID="$host" node -
}

hub_register() {
  local slug=$1 ticket=$2 rig=$3
  local host bf sub
  host=$(name_of "$slug"); bf=$(hub_bearer_file "$slug"); sub="feed.subscriptions.$host.enabled"

  if ! hub_ready; then
    log "WARNING: no Ready hub pod $HUB_POD, so team $host is NOT registered with any hub: no hosts.yaml entry, no bearer file $bf, no $sub. The team works; the hub just does not see it. Re-run '$0 start $ticket' once the hub is Ready."
    return 0
  fi
  local url bearer
  url=$(hub_host_url "$slug")
  bearer=$(team_bearer "$slug")
  [ -n "$bearer" ] || die "secret $host has no bearer key; cannot register it with the hub"

  # The bearer travels on stdin, never in a command line the node can see.
  printf '%s' "$bearer" | hub_exec sh -c "umask 077; mkdir -p $(dirname "$bf"); cat > '$bf'; chmod 0600 '$bf'" \
    || die "could not write $bf in $HUB_POD; $host has no bearer file on the hub"

  if hub_registry has "$host" >/dev/null 2>&1; then
    log "hub already has host $host"
  else
    hub_exec rig host add --id "$host" --transport http --url "$url" --bearer-file "$bf" \
      --notes "ticket $ticket, rig ${rig:-none}" >/dev/null \
      || die "the hub refused to register $host; it has a bearer file but no hosts.yaml entry"
    # Re-read rather than trust the verb: a subscription for a host missing from
    # hosts.yaml makes the hub report the team as unreachable forever.
    hub_registry has "$host" >/dev/null 2>&1 \
      || die "$host is still not in the hub's hosts.yaml after rig host add"
    log "registered $host with the hub at $url"
  fi
  # Without the subscription the hub lists the host but never reads its queue state, which is
  # as misleading as a missing host, so it fails the same way instead of being logged away.
  hub_exec rig config set "$sub" true >/dev/null \
    || die "host $host is registered but $sub is not true: the hub will show it without its queue"
}

hub_unregister() {
  local slug=$1
  local host bf sub
  host=$(name_of "$slug"); bf=$(hub_bearer_file "$slug"); sub="feed.subscriptions.$host.enabled"

  if ! hub_ready; then
    log "WARNING: no Ready hub pod $HUB_POD, so $host is STILL registered with it. Once the hub is Ready, clean it by hand: drop the $host entry from ~/.openrig/hosts.yaml, run 'rig config reset $sub', and delete ~/.openrig/hosts.d/$host.bearer."
    return 0
  fi
  local ok=1
  hub_registry remove "$host" >/dev/null 2>&1 || { ok=0; log "could not remove $host from the hub's hosts.yaml or host-bindings.json"; }
  # `rig config reset` is the unset: it drops the whole feed.subscriptions.<host> node.
  hub_exec rig config reset "$sub" >/dev/null 2>&1 || { ok=0; log "could not reset $sub on the hub"; }
  hub_exec rm -f "$bf" >/dev/null 2>&1 || { ok=0; log "could not remove $bf from the hub"; }
  if [ "$ok" = 1 ]; then
    log "unregistered $host from the hub"
  else
    log "WARNING: $host is only partly unregistered; check hosts.yaml, $sub and $bf on $HUB_POD by hand"
  fi
}

# --- start -------------------------------------------------------------------------------------

team_manifests() {
  # args: slug ticket repo ref spec image cpu memory storage envjson bearer
  jq -n --arg slug "$1" --arg ticket "$2" --arg repo "$3" --arg ref "$4" --arg spec "$5" \
    --arg image "$6" --arg cpu "$7" --arg mem "$8" --arg storage "$9" --argjson extra "${10}" \
    --arg bearer "${11}" --arg ann "$ANN" '
    ($slug | "t-" + .) as $name |
    {app: "openrig-team", ($ann + "/role"): "team", ($ann + "/ticket"): $slug} as $labels |
    {apiVersion: "v1", kind: "List", items: [
      {apiVersion: "v1", kind: "Secret", type: "Opaque",
       metadata: {name: $name, labels: $labels},
       stringData: {bearer: $bearer}},
      {apiVersion: "apps/v1", kind: "StatefulSet",
       metadata: {name: $name, labels: $labels,
         annotations: {($ann + "/ticket-key"): $ticket, ($ann + "/repo"): $repo, ($ann + "/ref"): $ref,
                       ($ann + "/spec"): $spec}},
       spec: {
         serviceName: "teams", replicas: 1,
         selector: {matchLabels: {($ann + "/ticket"): $slug}},
         persistentVolumeClaimRetentionPolicy: {whenDeleted: "Delete", whenScaled: "Retain"},
         template: {
           metadata: {labels: $labels},
           spec: {
             automountServiceAccountToken: false,
             securityContext: {runAsNonRoot: true, runAsUser: 1000, runAsGroup: 1000, fsGroup: 1000,
                               seccompProfile: {type: "RuntimeDefault"}},
             imagePullSecrets: [{name: "ghcr-pull"}],
             terminationGracePeriodSeconds: 60,
             containers: [{
               name: "daemon", image: $image,
               securityContext: {allowPrivilegeEscalation: false, capabilities: {drop: ["ALL"]}},
               ports: [{name: "daemon", containerPort: 7433}],
               env: ([
                 {name: "OPENRIG_HOST_NAME", value: $name},
                 {name: "OPENRIG_BIND_HOST", value: "0.0.0.0"},
                 {name: "OPENRIG_PORT", value: "7433"},
                 {name: "OPENRIG_NO_KERNEL", value: "1"},
                 {name: "OPENRIG_AUTH_BEARER_TOKEN",
                  valueFrom: {secretKeyRef: {name: $name, key: "bearer"}}},
                 {name: "OPENRIG_WORKSPACE_REPO", value: $repo},
                 {name: "GIT_USER_NAME", value: ("OpenRig team " + $name)}
               ]
               + (if $ref == "" then [] else [{name: "OPENRIG_WORKSPACE_REF", value: $ref}] end)
               + $extra),
               envFrom: [{secretRef: {name: "openrig-agents"}}],
               readinessProbe: {httpGet: {path: "/healthz", port: "daemon"}, periodSeconds: 10},
               resources: {requests: {cpu: $cpu, memory: $mem}, limits: {memory: $mem}},
               volumeMounts: [{name: "home", mountPath: "/home/openrig"},
                              {name: "kit", mountPath: "/etc/openrig-kit", readOnly: true}]
             }],
             volumes: [{name: "kit", configMap: {name: "openrig-kit", defaultMode: 292,
               items: [
                 {key: "rig.yaml", path: "rig.yaml"},
                 {key: "lead-monitoring.md", path: "guidance/lead-monitoring.md"},
                 {key: "pi-seat-status", path: "bin/pi-seat-status", mode: 365},
                 {key: "openrig-heartbeat.ts", path: "pi-extensions/openrig-heartbeat.ts"},
                 {key: "models.json", path: "pi/models.json"}]}}]
           }
         },
         volumeClaimTemplates: [{metadata: {name: "home"},
           spec: {accessModes: ["ReadWriteOnce"], resources: {requests: {storage: $storage}}}}]
       }}
    ]}'
}

# KEY=VALUE lines -> a JSON env array. Values are taken verbatim.
env_json() {
  local out='[]' line
  for line in "$@"; do
    [[ "$line" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || die "bad --env '$line' (want NAME=VALUE)"
    out=$(jq -c --arg n "${line%%=*}" --arg v "${line#*=}" '. + [{name: $n, value: $v}]' <<<"$out")
  done
  printf '%s' "$out"
}

wait_ready() {
  local slug=$1 timeout=$2 pod deadline
  pod=$(pod_of "$slug"); deadline=$((SECONDS + timeout))
  until k get pod "$pod" >/dev/null 2>&1; do
    [ $SECONDS -lt $deadline ] || die "$pod was not created within ${timeout}s"
    sleep 2
  done
  log "waiting for $pod to be Ready"
  k wait --for=condition=Ready "pod/$pod" --timeout="$((deadline - SECONDS > 1 ? deadline - SECONDS : 1))s" >/dev/null \
    || die "$pod is not Ready; inspect it with: $KUBECTL -n $NS describe pod $pod"
}

# Brings the team's rig up, or back after a pod restart. Records the rig name on the StatefulSet.
ensure_rig() {
  local slug=$1 sts rig spec nodes out
  sts=$(sts_json "$slug"); rig=$(annotation "$sts" rig); spec=$(annotation "$sts" spec)
  if [ -z "$rig" ]; then
    log "rig up $spec"
    out=$(inpod "$slug" rig up "$spec" --yes --json) || die "rig up failed: $out"
    rig=$(jq -r '[.. | objects | .specName? // empty] | first // empty' <<<"$out")
    [ -n "$rig" ] || die "rig up gave no rig name: $(head -c 400 <<<"$out")"
    annotate "$slug" rig "$rig"
    return
  fi
  nodes=$(inpod "$slug" rig ps --nodes --rig "$rig" --json 2>/dev/null || echo '[]')
  if ! jq -e 'length > 0 and all(.[]; .sessionStatus == "running")' >/dev/null <<<"$nodes"; then
    log "restoring rig $rig"
    inpod "$slug" rig up "$rig" --existing --yes --json >/dev/null || die "restoring $rig failed"
  fi
}

lead_session() {
  local slug=$1 rig=$2 lead=$3
  inpod "$slug" rig ps --nodes --rig "$rig" --json |
    jq -r --arg l "$lead" '.[] | select(.logicalId == $l) | .canonicalSessionName' | head -1
}

brief_with_contract() {
  local slug=$1 file=$2
  cat "$file"
  cat <<EOF


---
Completion contract (from the dispatcher; follow it exactly):

1. Work in /home/openrig/work/project. Commit the change on branch ticket/$slug.
2. The change is complete only after your reviewer has approved it.
3. Then write $RESULT as JSON:
   {"status": "done" | "failed" | "needs-human", "branch": "ticket/$slug", "commit": "<sha>", "summary": "<what changed and how it was verified>"}
   Use "needs-human" when you need a decision; ask for it on the queue, and overwrite the file once you continue.
4. Close your queue items. Do not push; this pod has no Git credentials.
EOF
}

cmd_start() {
  local ticket="" repo="" ref="" spec=/etc/openrig-kit/rig.yaml brief="" image="${RIG_DISPATCH_IMAGE:-}"
  local cpu=500m mem=4Gi storage=20Gi lead=orch.lead ready_timeout=600
  local -a envs=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) repo=$2; shift 2 ;;
      --ref) ref=$2; shift 2 ;;
      --spec) spec=$2; shift 2 ;;
      --brief-file) brief=$2; shift 2 ;;
      --image) image=$2; shift 2 ;;
      --env) envs+=("$2"); shift 2 ;;
      --cpu) cpu=$2; shift 2 ;;
      --memory) mem=$2; shift 2 ;;
      --storage) storage=$2; shift 2 ;;
      --lead) lead=$2; shift 2 ;;
      --ready-timeout) ready_timeout=$2; shift 2 ;;
      -*) die "unknown option $1" ;;
      *) [ -z "$ticket" ] || die "one ticket at a time"; ticket=$1; shift ;;
    esac
  done
  [ -n "$ticket" ] || usage
  local slug sts
  slug=$(slug_of "$ticket")
  sts=$(sts_json "$slug" || true)

  if [ -z "$sts" ]; then
    [ -n "$repo" ] || die "--repo is required for a new ticket"
    [ -n "$brief" ] && [ -f "$brief" ] || die "--brief-file is required for a new ticket"
    [ -n "$image" ] || image=$(default_image)
    # Site defaults for the kit's rigs, e.g. which seats need Pi seeding.
    if [ -f "$HERE/team.env" ]; then
      while IFS= read -r line; do
        [[ -z "$line" || "$line" == \#* ]] || envs=("$line" "${envs[@]}")
      done < "$HERE/team.env"
    fi
    local bearer
    bearer=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')
    log "creating $(name_of "$slug") for $ticket ($image)"
    team_manifests "$slug" "$ticket" "$repo" "$ref" "$spec" "$image" "$cpu" "$mem" "$storage" \
      "$(env_json "${envs[@]}")" "$bearer" | k apply -f - >/dev/null
    unset bearer
  else
    log "$(name_of "$slug") exists; resuming"
  fi

  wait_ready "$slug" "$ready_timeout"
  ensure_rig "$slug"

  sts=$(sts_json "$slug")
  if [ -z "$(annotation "$sts" qitem)" ]; then
    [ -n "$brief" ] && [ -f "$brief" ] || die "--brief-file is required to hand over the ticket"
    local rig session qitem
    rig=$(annotation "$sts" rig)
    session=$(lead_session "$slug" "$rig" "$lead")
    [ -n "$session" ] || die "no seat '$lead' in rig $rig (use --lead <logicalId>)"
    brief_with_contract "$slug" "$brief" | inpod "$slug" sh -c "cat > $WORK/brief.md"
    qitem=$(inpod "$slug" rig queue create --source "dispatcher@$NS" --destination "$session" \
      --tags "ticket:$slug" --summary "$(annotation "$sts" ticket-key): $(head -n1 "$brief" | sed 's/^#* *//' | cut -c1-100)" \
      --body-file "$WORK/brief.md" --json | jq -r '.qitemId // .qitem.qitemId // empty')
    [ -n "$qitem" ] || die "queue create returned no qitem id"
    annotate "$slug" qitem "$qitem"
    annotate "$slug" lead "$lead"
    log "handed $ticket to $session as $qitem"
  fi
  # After the handover, on purpose: the hub is a view-only extra, and a hub that is Ready but
  # failing (pods/exec RBAC, a full volume, a hosts.yaml `rig host add` refuses) must never
  # leave a team running with no ticket. The failure is still loud and still exits non-zero.
  hub_register "$slug" "$ticket" "$(annotation "$(sts_json "$slug")" rig)"
  cmd_status "$ticket"
}

# --- status / wait ---------------------------------------------------------------------------

# One JSON object describing a ticket, read from the cluster and the pod.
probe() {
  local slug=$1 sts pod ready rig nodes items result
  sts=$(sts_json "$slug") || { jq -n --arg s "$slug" '{slug: $s, phase: "absent"}'; return; }
  pod=$(k get pod "$(pod_of "$slug")" -o json 2>/dev/null || echo '{}')
  ready=$(jq -r '[.status.conditions[]? | select(.type == "Ready") | .status] | first // "False"' <<<"$pod")
  rig=$(annotation "$sts" rig)
  nodes='[]' items='[]' result='null'
  if [ "$ready" = True ]; then
    [ -z "$rig" ] || nodes=$(inpod "$slug" rig ps --nodes --rig "$rig" --json 2>/dev/null || echo '[]')
    items=$(inpod "$slug" rig queue list -a -A -o json --limit 500 2>/dev/null |
      jq -c --arg t "ticket:$slug" '[.[] | select((.tags // []) | index($t))]' 2>/dev/null || echo '[]')
    result=$(inpod "$slug" sh -c "cat $RESULT 2>/dev/null; true" | jq -c . 2>/dev/null || echo 'null')
    [ -n "$result" ] || result=null
  fi
  jq -n --arg slug "$slug" --argjson sts "$sts" --argjson pod "$pod" --arg ready "$ready" \
    --arg rig "$rig" --argjson nodes "$nodes" --argjson items "$items" --argjson result "$result" --arg ann "$ANN" '
    {slug: $slug, ticket: $sts.metadata.annotations[$ann + "/ticket-key"], rig: $rig,
     qitem: $sts.metadata.annotations[$ann + "/qitem"], created: $sts.metadata.creationTimestamp,
     pod: ($pod.status.phase // "None"), ready: ($ready == "True"),
     seats: [$nodes[] | {seat: .logicalId, session: .canonicalSessionName, status: .sessionStatus,
                         activity: (.agentActivity.state // "unknown")}],
     open: [$items[] | select(.state as $s | ["pending", "in-progress", "blocked"] | index($s)) |
            {qitemId, state, destination: .destinationSession}],
     result: $result}
    | .phase = (if .result != null then "result:" + (.result.status // "?")
                elif .ready | not then "starting"
                elif .rig == "" then "ready"
                elif .qitem == null then "up"
                elif ([.seats[] | select(.status != "running")] | length) > 0 then "degraded"
                elif ([.open[] | select(.state == "blocked")] | length) > 0 then "blocked"
                else "working" end)'
}

team_slugs() {
  k get statefulsets -l "$ANN/role=team" -o json | jq -r --arg a "$ANN/ticket" '.items[].metadata.labels[$a]'
}

cmd_status() {
  local json=0 ticket="" slug
  while [ $# -gt 0 ]; do
    case "$1" in --json) json=1; shift ;; -*) die "unknown option $1" ;; *) ticket=$1; shift ;; esac
  done
  local -a slugs
  if [ -n "$ticket" ]; then slugs=("$(slug_of "$ticket")"); else mapfile -t slugs < <(team_slugs); fi
  local all='[]'
  for slug in "${slugs[@]}"; do
    [ -n "$slug" ] || continue
    all=$(jq -c --argjson p "$(probe "$slug")" '. + [$p]' <<<"$all")
  done
  if [ $json = 1 ]; then jq . <<<"$all"; return; fi
  jq -r '
    (["TICKET", "PHASE", "SEATS", "OPEN", "CREATED", "SUMMARY"] | @tsv),
    (.[] | [(.ticket // .slug), .phase,
            ([.seats[] | "\(.seat)=\(.activity)"] | join(",") | if . == "" then "-" else . end),
            (.open | length | tostring), (.created // "-"),
            ((.result.summary // "") | .[0:60])] | @tsv)' <<<"$all" | column -t -s $'\t'
}

# What changes while a team makes progress: its queue items and its workspace.
progress_fingerprint() {
  local slug=$1 p=$2
  { jq -c '[.open[] | [.qitemId, .state, .destination]]' <<<"$p"
    inpod "$slug" sh -c "cd $WORK/project && git rev-parse HEAD && git status --porcelain && git diff | md5sum" 2>/dev/null
  } | md5sum | cut -d' ' -f1
}

# A seat can sit in a dead loop while its lead idles, and nothing inside the team notices (an idle
# agent does not wake up to check on others). After --stall minutes without progress, nudge the lead.
nudge_lead() {
  local slug=$1 minutes=$2 sts session
  sts=$(sts_json "$slug")
  session=$(lead_session "$slug" "$(annotation "$sts" rig)" "$(annotation "$sts" lead || true)")
  [ -n "$session" ] || session=$(lead_session "$slug" "$(annotation "$sts" rig)" orch.lead)
  [ -n "$session" ] || { log "no lead seat to nudge"; return; }
  inpod "$slug" rig send "$session" "From the dispatcher: no progress on this ticket for $minutes minutes (queue items, HEAD and working tree unchanged). Check every seat now: is one stuck in a loop, waiting on something that already finished, or waiting for a decision? Unblock it, or write $RESULT with status needs-human and the question." >/dev/null 2>&1 \
    && log "nudged $session after $minutes minutes without progress" || log "could not nudge $session"
}

cmd_wait() {
  local ticket="" timeout=7200 interval=30 stall=20
  while [ $# -gt 0 ]; do
    case "$1" in --timeout) timeout=$2; shift 2 ;; --interval) interval=$2; shift 2 ;;
      --stall) stall=$2; shift 2 ;;
      -*) die "unknown option $1" ;; *) ticket=$1; shift ;; esac
  done
  [ -n "$ticket" ] || usage
  local slug deadline p phase last="" fp prev_fp="" since=$SECONDS
  slug=$(slug_of "$ticket"); deadline=$((SECONDS + timeout))
  while :; do
    p=$(probe "$slug"); phase=$(jq -r .phase <<<"$p")
    [ "$phase" = "$last" ] || log "$ticket: $phase"; last=$phase
    case "$phase" in
      absent) die "$ticket has no team" ;;
      result:done) jq .result <<<"$p"; return 0 ;;
      result:needs-human) jq .result <<<"$p"; return 3 ;;
      result:*) jq .result <<<"$p"; return 1 ;;
      degraded) ensure_rig "$slug" ;;
      working|blocked)
        fp=$(progress_fingerprint "$slug" "$p")
        if [ "$fp" != "$prev_fp" ]; then prev_fp=$fp; since=$SECONDS
        elif [ $((SECONDS - since)) -ge $((stall * 60)) ]; then
          nudge_lead "$slug" "$(((SECONDS - since) / 60))"; since=$SECONDS
        fi ;;
    esac
    [ $SECONDS -lt $deadline ] || { log "timed out after ${timeout}s"; return 4; }
    sleep "$interval"
  done
}

# --- archive ---------------------------------------------------------------------------------
#
# A team's whole history lives on its own pod volume and is deleted with the pod, so `archive`
# copies out everything that explains the ticket while the pod is still there. Every part is saved
# on its own and named in manifest.json with its row count or its error: one unreadable part costs
# that part, never the archive. Nothing here is swallowed the way `|| true` swallowed a failed
# usage read -- a part that could not be read is written down as not read.
#
# The reads are the daemon's own, over loopback inside the pod: `rig` for the CLI-backed streams,
# and the same loopback with the pod's own bearer for the audit rows, which have no CLI verb.

ARCHIVE_ROOT_DEFAULT=./tickets
QUEUE_LIMIT="${RIG_DISPATCH_QUEUE_LIMIT:-100000}"
MAX_PAGES="${RIG_DISPATCH_MAX_PAGES:-100000}"   # an opt-in ceiling, not a normal failure: termination comes from the cursor contract
AUDIT_PAGE=200     # the audit browse clamps anything larger to 200 anyway
TELEMETRY_PAGE=128 # the telemetry v1 contract caps a page at 128 source rows

PARTS='[]'
SCRATCH=""
PART_ERR=""

part_ok() { # part_ok <name> <rows> [note]
  PARTS=$(jq -c --arg n "$1" --argjson r "${2:-null}" --arg note "${3:-}" \
    '. + [{name: $n, ok: true, rows: $r} + (if $note == "" then {} else {note: $note} end)]' <<<"$PARTS")
}

part_failed() { # part_failed <name> <error>
  PARTS=$(jq -c --arg n "$1" --arg e "$2" \
    '. + [{name: $n, ok: false, rows: null, error: $e}]' <<<"$PARTS")
}

# Row count whatever shape a payload came in as: a list is its length, an object carrying rows or
# items is the length of those, and any other single document counts as one row.
rows_of() {
  jq -r 'if type == "array" then length
         elif type == "object" then
           (if (((.rows? // .items?) // null) | type) == "array" then ((.rows // .items) | length) else 1 end)
         else 0 end' "$1"
}

# save_part <name> <dest> <producer> [args...] -- run the producer, keep its stdout only when it is
# JSON. A failed command or junk output fails the part and leaves no file behind, so the archive
# never holds a part that looks saved and is not. The failure is recorded in PARTS rather than
# returned, because one unreadable part must not abort the run: everything else is still saved.
save_part() {
  local name=$1 dest=$2 producer=$3; shift 3
  local out e
  PART_ERR=""
  out=$(mktemp "$SCRATCH/part.XXXXXX")
  if ! "$producer" "$@" >"$out" 2>"$SCRATCH/part-err"; then
    e=${PART_ERR:-$(head -c 300 "$SCRATCH/part-err" | tr '\n\r' '  ')}
    part_failed "$name" "${e:-the command exited non-zero with no message}"; rm -f "$out"; return 0
  fi
  if ! jq -e . "$out" >/dev/null 2>&1; then
    part_failed "$name" "output is not JSON: $(head -c 200 "$out" | tr '\n\r' '  ')"; rm -f "$out"; return 0
  fi
  mv "$out" "$dest"
  part_ok "$name" "$(rows_of "$dest")"
}

# Coverage status across pages, worst seen wins: a later complete page must not hide an earlier
# partial one, because report reads this field to decide whether the history may be short.
worst_coverage() { # worst_coverage <current> <new>
  local rank_a rank_b
  case "$1" in retained_window) rank_a=0 ;; partial) rank_a=1 ;; *) rank_a=2 ;; esac
  case "$2" in retained_window) rank_b=0 ;; partial) rank_b=1 ;; *) rank_b=2 ;; esac
  if [ "$rank_b" -gt "$rank_a" ]; then printf '%s' "$2"; else printf '%s' "$1"; fi
}

# One telemetry stream, paged to the end. `rig telemetry` reads a single page and prints the cursor
# rather than following it, so following it here is the only way past 128 source rows. `--start
# retained` is what makes the first page begin at the retained floor: without it the stream opens at
# the high watermark and reads no history at all. A cursor that stops advancing is recorded as
# stalled rather than passed off as the whole history; the page budget sits on top of that as an
# opt-in limit and names itself when it is what ran out.
read_telemetry() { # read_telemetry <slug> <events|transitions>
  local slug=$1 stream=$2 cursor="" pages=0 stalled=false overbudget=false
  local status="retained_window" last="" next scanned rows_total=0 gapcount=0 watermark="" w
  : > "$SCRATCH/rows.jsonl"; : > "$SCRATCH/gaps.jsonl"
  while :; do
    local -a args=(--limit "$TELEMETRY_PAGE" --json)
    if [ -n "$cursor" ]; then args+=(--cursor "$cursor"); else args+=(--start retained); fi
    if ! inpod "$slug" rig telemetry "$stream" "${args[@]}" >"$SCRATCH/page" 2>"$SCRATCH/page-err"; then
      PART_ERR=$(head -c 300 "$SCRATCH/page-err" | tr '\n\r' '  '); return 1
    fi
    if ! jq -e . "$SCRATCH/page" >/dev/null 2>&1; then
      PART_ERR="page $((pages + 1)) is not JSON: $(head -c 200 "$SCRATCH/page" | tr '\n\r' '  ')"; return 1
    fi
    jq -c '.rows[]?' "$SCRATCH/page" >> "$SCRATCH/rows.jsonl"
    jq -c '.coverage.gaps[]?' "$SCRATCH/page" >> "$SCRATCH/gaps.jsonl"
    rows_total=$((rows_total + $(jq -c '(.rows // []) | length' "$SCRATCH/page")))
    # gapCount is the true count; coverage.gaps carries at most 32 detail rows per page.
    gapcount=$((gapcount + $(jq -r '.coverage.gapCount // 0' "$SCRATCH/page")))
    status=$(worst_coverage "$status" "$(jq -r '.coverage.status // "unknown"' "$SCRATCH/page")")
    # R3: `through` is fixed when the window opens and is the last row this read can include, so it is
    # what the archive actually holds. `retainedHighWatermark` is recomputed per page and can sit past
    # the last row read when the team writes during a multi-page read.
    w=$(jq -r '.page.through // ""' "$SCRATCH/page")
    if [ -n "$w" ]; then watermark=$w; fi
    pages=$((pages + 1))
    [ "$(jq -r '.page.hasMore' "$SCRATCH/page")" = true ] || break
    scanned=$(jq -r '.page.lastScanned // ""' "$SCRATCH/page")
    next=$(jq -r '.page.nextCursor // ""' "$SCRATCH/page")
    if [ -z "$next" ] || [ "$next" = "$cursor" ] || [ "$scanned" = "$last" ]; then stalled=true; break; fi
    cursor=$next; last=$scanned
    [ "$pages" -lt "$MAX_PAGES" ] || { overbudget=true; break; }
  done
  # A stream that would be saved short is not worth saving: a reader cannot tell a truncated history
  # from a quiet ticket. Fail the part, and name the knob when the knob is what stopped the read.
  if [ "$overbudget" = true ]; then
    PART_ERR="the page budget RIG_DISPATCH_MAX_PAGES=$MAX_PAGES ran out after $rows_total $stream rows with more retained; raise it to archive a long ticket"
    return 1
  fi
  if [ "$stalled" = true ]; then
    PART_ERR="the $stream cursor stopped after $pages page(s) with more retained rows, so the history would be incomplete"
    return 1
  fi
  jq -n --arg stream "$stream" --argjson pages "$pages" --arg status "$status" \
    --argjson stalled "$stalled" --arg watermark "$watermark" --argjson gapCount "$gapcount" \
    --slurpfile rows "$SCRATCH/rows.jsonl" --slurpfile gaps "$SCRATCH/gaps.jsonl" \
    '{stream: $stream, pages: $pages, coverageStatus: $status, stalled: $stalled,
      through: (if $watermark == "" then null else $watermark end),
      gapCount: $gapCount, rows: $rows, gaps: $gaps}'
}

# The mission-control audit rows have no CLI verb, so this is the daemon's own HTTP read over
# loopback with the bearer the entrypoint left for the CLI -- the same token, the same host check.
# `before_id` walks the rows backwards, 200 at a time. These rows are the only place a relayed human
# answer names the host it came from (auditNotes.openrig_relay.from_host), so they are archived whole.
read_audit() { # read_audit <slug> <qitem>
  local slug=$1 qitem=$2 before="" pages=0 stalled=false overbudget=false next rows_total=0
  : > "$SCRATCH/audit-rows.jsonl"
  while :; do
    if ! inpod "$slug" sh -c '
        tok=$(cat "${OPENRIG_HOME:-$HOME/.openrig}/terminal-token" 2>/dev/null)
        url="http://127.0.0.1:${OPENRIG_PORT:-7433}/api/mission-control/audit?qitem_id=$1&limit=$2"
        if [ -n "$3" ]; then url="$url&before_id=$3"; fi
        curl -fsS -H "Authorization: Bearer $tok" "$url"
      ' sh "$qitem" "$AUDIT_PAGE" "$before" >"$SCRATCH/page" 2>"$SCRATCH/page-err"; then
      PART_ERR=$(head -c 300 "$SCRATCH/page-err" | tr '\n\r' '  ')
      [ -n "$PART_ERR" ] || PART_ERR="the audit read failed"
      return 1
    fi
    if ! jq -e . "$SCRATCH/page" >/dev/null 2>&1; then
      PART_ERR="audit page $((pages + 1)) is not JSON: $(head -c 200 "$SCRATCH/page" | tr '\n\r' '  ')"; return 1
    fi
    jq -c '.rows[]?' "$SCRATCH/page" >> "$SCRATCH/audit-rows.jsonl"
    rows_total=$((rows_total + $(jq -c '(.rows // []) | length' "$SCRATCH/page")))
    pages=$((pages + 1))
    [ "$(jq -r '.hasMore' "$SCRATCH/page")" = true ] || break
    next=$(jq -r '.nextBeforeId // ""' "$SCRATCH/page")
    if [ -z "$next" ] || [ "$next" = "$before" ]; then stalled=true; break; fi
    before=$next
    [ "$pages" -lt "$MAX_PAGES" ] || { overbudget=true; break; }
  done
  if [ "$overbudget" = true ]; then
    PART_ERR="the page budget RIG_DISPATCH_MAX_PAGES=$MAX_PAGES ran out after $rows_total audit rows for $qitem with more retained; raise it to archive a long ticket"
    return 1
  fi
  if [ "$stalled" = true ]; then
    PART_ERR="the audit cursor for $qitem stopped after $pages page(s) with more rows, so the rows would be incomplete"
    return 1
  fi
  jq -n --arg q "$qitem" --argjson pages "$pages" --argjson stalled "$stalled" \
    --slurpfile rows "$SCRATCH/audit-rows.jsonl" \
    '{qitemId: $q, pages: $pages, stalled: $stalled, rows: $rows}'
}

# Every queue row in the pod, with no 500-row ceiling: the daemon route passes the limit through and
# the CLI takes any positive integer, so the ceiling was always the dispatcher's own. Nothing is
# filtered by tag, because a team pod holds ONE ticket's database - which the events and transitions
# streams already assume - and a review or a human question the team opened itself carries no
# dispatcher tag, so filtering here would drop exactly the rounds and decisions report is asked for.
# The dispatcher's own item is named by the StatefulSet's `qitem` annotation, not by a filter.
ticket_queue() {
  local slug=$1
  inpod "$slug" rig queue list -a -A -o json --full --limit "$QUEUE_LIMIT"
}

# The high watermark a saved telemetry envelope recorded, or empty when the part is not there.
watermark_of() { if [ -f "$1" ]; then jq -r '.through // ""' "$1" 2>/dev/null || true; fi; }

cmd_archive() {
  local ticket="" dir=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dir) dir=$2; shift 2 ;;
      -*) die "unknown option $1" ;;
      *) [ -z "$ticket" ] || die "one ticket at a time"; ticket=$1; shift ;;
    esac
  done
  [ -n "$ticket" ] || usage
  local slug p rig root out old key qitem seat raw complete incarnation watermarks
  slug=$(slug_of "$ticket")
  p=$(probe "$slug")
  jq -e '.ready' >/dev/null <<<"$p" || die "$ticket: the team pod is not Ready, so there is nothing to archive"
  root=${dir:-${RIG_DISPATCH_ARCHIVE_DIR:-$ARCHIVE_ROOT_DEFAULT}}
  key=$(jq -r '.ticket // empty' <<<"$p")
  rig=$(jq -r '.rig // empty' <<<"$p")
  mkdir -p "$root" || die "cannot create the archive root $root"
  out="$root/$slug"
  TMP=$(mktemp -d "$root/.${slug}.partial.XXXXXX") || die "cannot make a temporary directory in $root"
  trap '[ -n "${TMP:-}" ] && rm -rf "$TMP" || true' EXIT
  SCRATCH="$TMP/.scratch"; mkdir -p "$SCRATCH"
  PARTS='[]'

  save_part status "$TMP/status.json" printf '%s\n' "$p"
  save_part queue "$TMP/queue.json" ticket_queue "$slug"
  if [ -n "$rig" ]; then
    save_part nodes "$TMP/nodes.json" inpod "$slug" rig ps --nodes --rig "$rig" --json
  else
    part_failed nodes "the StatefulSet has no rig annotation, so the seats cannot be listed"
  fi

  for seat in $(jq -r '.seats[].session // empty' <<<"$p"); do
    save_part "usage:$seat" "$TMP/usage-$seat.json" inpod "$slug" rig usage series --seat "$seat" --json
  done
  save_part usage-top "$TMP/usage-top.json" inpod "$slug" rig usage top --json

  save_part events "$TMP/events.json" read_telemetry "$slug" events
  save_part transitions "$TMP/queue-transitions.json" read_telemetry "$slug" transitions

  # One part per queue item: one item whose audit rows will not read costs that item's rows, not the
  # whole audit, and the manifest then names exactly which item it was.
  if [ -f "$TMP/queue.json" ]; then
    for qitem in $(jq -r '.[].qitemId // empty' "$TMP/queue.json"); do
      save_part "audit:$qitem" "$TMP/audit-$qitem.json" read_audit "$slug" "$qitem"
    done
  else
    part_failed audit "the queue part failed, so the ticket's queue items are unknown and no audit rows could be asked for"
  fi

  # The raw result.json, not only what the status probe read out of it. Absent is a state of the
  # ticket, not a failure of the archive, so it is a note rather than an error.
  if raw=$(inpod "$slug" sh -c "cat $RESULT 2>/dev/null || true"); then
    if [ -n "$raw" ]; then
      printf '%s\n' "$raw" > "$TMP/result.json"
      if jq -e . "$TMP/result.json" >/dev/null 2>&1; then part_ok result 1
      else part_ok result 1 "the pod's result.json is not valid JSON"; fi
    else
      part_ok result 0 "the pod has written no result.json yet"
    fi
  else
    part_failed result "could not read $RESULT from the pod"
  fi

  rm -rf "$SCRATCH"
  complete=$(jq -r 'if any(.[]; .ok | not) then "false" else "true" end' <<<"$PARTS")
  # Two facts the delete guard needs later: WHICH pod this archive describes (a re-dispatched ticket
  # reuses the slug) and how far the two streams had reached when it was read (a team that kept
  # working after this run has history this archive does not hold).
  incarnation=$(jq -r '.created // empty' <<<"$p")
  watermarks=$(jq -n --arg ev "$(watermark_of "$TMP/events.json")" --arg tr "$(watermark_of "$TMP/queue-transitions.json")" \
    '{events: (if $ev == "" then null else $ev end), transitions: (if $tr == "" then null else $tr end)}')
  jq -n --arg slug "$slug" --arg ticket "$key" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg dir "$out" --argjson parts "$PARTS" --argjson complete "$complete" \
    --arg inc "${incarnation:-}" --argjson wm "$watermarks" \
    '{slug: $slug, ticket: $ticket, archivedAt: $at, dir: $dir, complete: $complete,
      incarnation: (if $inc == "" then null else $inc end), watermarks: $wm, parts: $parts}' \
    > "$TMP/manifest.json" || die "could not write manifest.json in $TMP"

  # Swap the finished directory in. Two renames, so there is a moment with no $out, but a crash in
  # that moment leaves the complete previous archive at .<slug>.old: never half-old and half-new,
  # and never destroyed. A re-run replaces the whole directory, so nothing stale survives it.
  if [ -d "$out" ]; then
    old="$root/.${slug}.old.$$"
    mv "$out" "$old" || die "could not move the previous archive aside; nothing was changed"
    if ! mv "$TMP" "$out"; then
      mv "$old" "$out" || log "WARNING: the new archive did not land and the old one would not go back; it is at $old"
      die "could not move the new archive into $out; the previous archive is unchanged"
    fi
    rm -rf "$old"
  else
    mv "$TMP" "$out" || die "could not put the archive at $out"
  fi
  TMP=""

  jq -r '.parts[] | select(.ok) | "  saved \(.name): \(.rows // 0) rows"' "$out/manifest.json" >&2
  jq -r '.parts[] | select(.ok | not) | "  FAILED \(.name): \(.error)"' "$out/manifest.json" >&2
  log "archived $ticket in $out"
  [ "$complete" = true ] || return 1
}

# --- collect / answer / delete ---------------------------------------------------------------

cmd_collect() {
  local ticket="" archive="" into=""
  while [ $# -gt 0 ]; do
    case "$1" in --archive) archive=$2; shift 2 ;; --into) into=$2; shift 2 ;;
      -*) die "unknown option $1" ;; *) ticket=$1; shift ;; esac
  done
  [ -n "$ticket" ] || usage
  local slug p rig branch dir seat
  slug=$(slug_of "$ticket"); p=$(probe "$slug")
  jq -e '.ready' >/dev/null <<<"$p" || die "$ticket: the team pod is not Ready"
  dir=${archive:-./tickets}/$slug; mkdir -p "$dir"
  rig=$(jq -r .rig <<<"$p")

  jq . <<<"$p" > "$dir/status.json"
  inpod "$slug" rig queue list -a -A -o json --full --limit 500 |
    jq --arg t "ticket:$slug" '[.[] | select((.tags // []) | index($t))]' > "$dir/queue.json"
  inpod "$slug" rig ps --nodes --rig "$rig" --json > "$dir/nodes.json"
  for seat in $(jq -r '.seats[].session' <<<"$p"); do
    inpod "$slug" rig usage series --seat "$seat" --json > "$dir/usage-$seat.json" 2>/dev/null || true
  done
  inpod "$slug" rig usage top --json > "$dir/usage-top.json" 2>/dev/null || true

  branch=$(jq -r '.result.branch // empty' <<<"$p")
  if [ -n "$branch" ]; then
    # Only the commits the remote does not have; the receiving clone has the rest.
    inpod "$slug" git -C "$WORK/project" bundle create - "$branch" --not --remotes > "$dir/result.bundle" \
      || die "could not bundle branch $branch"
    if [ -n "$into" ]; then
      git -C "$into" fetch --quiet "$(realpath "$dir/result.bundle")" "$branch:refs/tickets/$slug"
      log "fetched $branch into $into as refs/tickets/$slug"
    fi
  else
    log "no result branch yet; archived status only"
  fi
  log "archived $ticket in $dir"
}

cmd_answer() {
  [ $# -ge 3 ] || usage
  local slug sts rig lead session
  slug=$(slug_of "$1")
  sts=$(sts_json "$slug") || die "$1 has no team"
  rig=$(annotation "$sts" rig)
  lead=$(annotation "$sts" lead || true); [ -n "$lead" ] || lead=orch.lead
  # `rig queue resolve` takes its actor from the seat env (X-OpenRig-Session), and a bare
  # `kubectl exec` shell has none, so name the ticket's lead explicitly. --actor is ignored.
  session=$(lead_session "$slug" "$rig" "$lead")
  [ -n "$session" ] || die "no seat '$lead' in rig $rig; cannot answer as a seat"
  inpod "$slug" env OPENRIG_SESSION_NAME="$session" rig queue resolve "$2" --decision "${*:3}" --json
}

cmd_delete() {
  [ $# -eq 1 ] || usage
  local slug sts rig name
  slug=$(slug_of "$1"); name=$(name_of "$slug")
  sts=$(sts_json "$slug" || true)
  # Unregister before the pod goes, so the hub never keeps a host it can no longer reach.
  hub_unregister "$slug"
  if [ -n "$sts" ]; then
    rig=$(annotation "$sts" rig)
    if [ -n "$rig" ] && k get pod "$(pod_of "$slug")" >/dev/null 2>&1; then
      inpod "$slug" rig down "$rig" >/dev/null 2>&1 || log "rig down failed; deleting anyway"
    fi
    k delete statefulset "$name" --wait=true >/dev/null
  fi
  k delete secret "$name" --ignore-not-found >/dev/null
  # whenDeleted: Delete removes the volume; this covers a StatefulSet deleted by other means.
  k delete pvc -l "$ANN/ticket=$slug" --ignore-not-found >/dev/null
  k delete pvc "home-$name-0" --ignore-not-found >/dev/null
  log "deleted $name"
}

[ $# -ge 1 ] || usage
cmd=$1; shift
case "$cmd" in
  start) cmd_start "$@" ;;
  status|ls) cmd_status "$@" ;;
  wait) cmd_wait "$@" ;;
  archive) cmd_archive "$@" ;;
  collect) cmd_collect "$@" ;;
  answer) cmd_answer "$@" ;;
  delete|rm) cmd_delete "$@" ;;
  -h|--help|help) usage ;;
  *) die "unknown command $cmd" ;;
esac
