#!/usr/bin/env bash
# rig-dispatch: one OpenRig team pod per ticket (design: deploy/kubernetes/docs/architecture.md).
#
#   rig-dispatch start   <ticket> --repo <url> --brief-file <file> [options]
#   rig-dispatch status  [<ticket>] [--json]
#   rig-dispatch wait    <ticket> [--timeout <seconds>] [--stall <minutes>]
#   rig-dispatch watch   <ticket>|--all [--collect] [--archive <dir>] [--timeout <seconds>]
#   rig-dispatch archive <ticket> [--dir <root>]
#   rig-dispatch collect <ticket> [--archive <dir>] [--into <local git repo>]
#   rig-dispatch report  <ticket>|--all [--dir <root>] [--json]
#   rig-dispatch answer  <ticket> <qitem> <decision text>
#   rig-dispatch delete  <ticket> [--dir <root>] [--force]
#   rig-dispatch hub-sync [--dry-run]
#
# State lives in Kubernetes labels and annotations and in the team pod, so every command can be
# run again. The dispatcher reaches team pods only through `kubectl exec`; inside the pod, `rig`
# talks to its own daemon over loopback. `watch` is the one command that also keeps state on the
# dispatcher's own machine: the last event id per ticket, so a restarted watcher resumes the team's
# event stream where it stopped instead of from the beginning.
#
# Environment: KUBECONFIG, KUBECTL (default kubectl), RIG_DISPATCH_NAMESPACE (default openrig),
# RIG_DISPATCH_IMAGE (default: the image pinned in ../kustomization.yaml), RIG_DISPATCH_HUB_POD
# (default hub-0; the hub to register teams with. No Ready hub pod there: registration is skipped).
# Archive: RIG_DISPATCH_ARCHIVE_DIR (default ./tickets, --dir wins), RIG_DISPATCH_QUEUE_LIMIT
# (default 100000 rows of queue history), RIG_DISPATCH_MAX_PAGES (default 100000 pages per paged read).
# Watch: RIG_DISPATCH_WATCH_DIR (default ~/.rig-dispatch/watch) holds the last event id per ticket,
# and RIG_DISPATCH_EVENTS_URL overrides where the event stream is (default the pod's own loopback).
# RIG_DISPATCH_WATCH_TICK (default 1s) is how often a quiet stream is re-checked for the verdict and
# the deadline; RIG_DISPATCH_WATCH_BACKSTOP (default 180s) is how often a quiet stream also gets a
# status read anyway; RIG_DISPATCH_EVENTS_MAX_TIME (default 300s) bounds one stream.
# Hub registry edits are serialized in the hub pod under RIG_DISPATCH_HUB_LOCK (default
# ~/.openrig/.registry.lock there), waiting RIG_DISPATCH_HUB_LOCK_TIMEOUT seconds (default 60).
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
NS="${RIG_DISPATCH_NAMESPACE:-openrig}"
KUBECTL="${KUBECTL:-kubectl}"
WORK=/home/openrig/work
RESULT="$WORK/result.json"
ANN=openrig.dev

die() { echo "rig-dispatch: $*" >&2; exit 1; }
log() { echo "[rig-dispatch] $*" >&2; }
k() { "$KUBECTL" -n "$NS" "$@"; }
need() { command -v "$1" >/dev/null || die "$1 is required"; }
need jq; need "$KUBECTL"

usage() { sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }

# PROJ-123 -> proj-123: a DNS label that is also a valid OpenRig host id (no dots).
slug_of() {
  local s
  s=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9-]+/-/g; s/^-+//; s/-+$//' | cut -c1-40)
  s=${s%-}
  [ -n "$s" ] || die "ticket '$1' gives an empty name"
  printf '%s' "$s"
}

name_of() { printf 't-%s' "$1"; }
pod_of() { printf 't-%s-0' "$1"; }
# `kubectl exec -i` copies the caller's stdin into the pod whether or not the command inside it ever
# reads, and whatever it takes is gone from the caller. So a pod read made while the caller is reading
# a stream drinks that stream: it ate the rest of a hub repair's input on a real cluster, and it ate
# `watch`'s own event stream the same way -- the status probe runs inside the loop that reads the
# stream. Rather than leave every caller to remember, the read closes stdin here and a caller that
# really means to send stdin says so by name (`inpod_stdin`, below).
inpod() { local slug=$1; shift; k exec -i "$(pod_of "$slug")" -c daemon -- "$@" </dev/null; }
inpod_stdin() { local slug=$1; shift; k exec -i "$(pod_of "$slug")" -c daemon -- "$@"; }
sts_json() { k get statefulset "$(name_of "$1")" -o json 2>/dev/null; }
annotation() { jq -r --arg k "$ANN/$2" '.metadata.annotations[$k] // empty' <<<"$1"; }
annotate() { k annotate --overwrite statefulset "$(name_of "$1")" "$ANN/$2=$3" >/dev/null; }

default_image() {
  local kz="$HERE/../kustomization.yaml"
  [ -f "$kz" ] || die "set RIG_DISPATCH_IMAGE"
  awk '/newName:/{n=$2} /newTag:/{t=$2} END{if(n&&t) print n":"t}' "$kz"
}

# --- hub ---------------------------------------------------------------------------------------
#
# The hub (../hub) is an OpenRig daemon with no rigs whose hosts.yaml lists every team pod, so one
# TUI shows every team at once. The dispatcher keeps it in step: `start` registers a team once its
# pod is Ready, `delete` unregisters it, and `hub-sync` repairs the two when they have drifted -- a
# hub that was not Ready, a StatefulSet removed by some other route, an edit that failed halfway. With
# no Ready hub pod in the namespace every helper here is a no-op and the dispatcher behaves exactly as
# it does without a hub. Every mutation below runs under one lock in the hub's volume; the reads do not.

HUB_POD="${RIG_DISPATCH_HUB_POD:-hub-0}"
_hub_npm_root=""

hub_ready() {
  "$KUBECTL" -n "$NS" get pod "$HUB_POD" -o json 2>/dev/null |
    jq -e 'any(.status.conditions[]?; .type == "Ready" and .status == "True")' >/dev/null 2>&1
}

# Same rule as `inpod`: stdin is closed unless the caller says otherwise with `hub_exec_stdin`. The
# hub's node scripts and the bearer write are the ones that do, and `hub_edit` passes stdin through on
# purpose, which is why its own callers pass `</dev/null` when they are only running a command.
hub_exec() { "$KUBECTL" -n "$NS" exec -i "$HUB_POD" -c daemon -- "$@" </dev/null; }
hub_exec_stdin() { "$KUBECTL" -n "$NS" exec -i "$HUB_POD" -c daemon -- "$@"; }

# What the hub dials. A bearer is required: the team pod binds 0.0.0.0, and sending one also
# satisfies the daemon's Host-header check, so the teams need no OPENRIG_ALLOWED_HOSTS.
hub_host_url() { printf 'http://%s.teams.%s.svc:7433' "$(pod_of "$1")" "$NS"; }
hub_bearer_file() { printf '/home/openrig/.openrig/hosts.d/%s.bearer' "$(name_of "$1")"; }
team_bearer() { k get secret "$(name_of "$1")" -o jsonpath='{.data.bearer}' | base64 -d; }

# The hub image has no PyYAML. The CLI's own `yaml` dependency is the same parser `rig host add`
# writes with, so the registry is edited with it.
hub_npm_root() {
  # Kept explicit even though `hub_exec` closes stdin now: this one is often called while a pipeline
  # has stdin open, and it is the read that first ate the script meant for the command after it.
  [ -n "$_hub_npm_root" ] || _hub_npm_root=$(hub_exec sh -c 'npm root -g' </dev/null 2>/dev/null | tail -n1)
  printf '%s' "$_hub_npm_root"
}

# The part every hub-side node script needs: where the registry lives, the same YAML parser `rig host
# add` writes with, and the tmp + rename write the CLI uses. Shared because two readers of hosts.yaml
# that disagree about its shape is how a registry gets corrupted rather than merely edited.
HUB_NODE_PRELUDE='
const fs = require("fs"), path = require("path");
const home = process.env.OPENRIG_HOME || process.env.HOME + "/.openrig";
const yamlFile = path.join(home, "hosts.yaml");
const bindFile = path.join(home, "host-bindings.json");
function loadYaml() {
  const r = process.env.NPM_ROOT;
  if (r) { try { return require(path.join(r, "@openrig/cli/node_modules/yaml")); } catch (e) {}
  }
  return require("yaml");
}
// tmp + rename, as the CLI does. The daemon re-reads hosts.yaml on every request, so an
// in-place truncate could be observed half written.
function writeAtomic(file, text) {
  const tmp = file + ".tmp-" + process.pid;
  fs.writeFileSync(tmp, text, { mode: 0o600 });
  fs.renameSync(tmp, file);
}
'

# --- the registry lock -------------------------------------------------------------------------
#
# Every hub-side registry mutation runs under this lock. `rig host add` and the removal below each
# read hosts.yaml, edit it in memory and write the whole file back, and `rig config set` does the same
# to the settings file -- so a `start` and a `delete` for two different tickets, at the same moment,
# can each read a file the other has not written yet and one team's entry is simply lost. Locking each
# edit closes exactly that, and it is the whole of what it closes: a multi-step register is still not
# atomic, so a crash between the bearer write and `rig host add` still leaves a half-registered team.
# That was true before the lock, it is reported by hub_register's own errors, and `hub-sync` repairs it.
HUB_LOCK="${RIG_DISPATCH_HUB_LOCK:-/home/openrig/.openrig/.registry.lock}"
HUB_LOCK_TIMEOUT="${RIG_DISPATCH_HUB_LOCK_TIMEOUT:-60}"

# hub_locked <cmd> [args...] -- the command, with its stdin, holding the lock.
#
# The fd form, not `flock -w N file -c cmd`: util-linux flock exits 1 when it gives up waiting, and 1
# is also what a failed edit exits with, so the -c form cannot tell "someone else is editing the hub"
# from "the edit failed". Here giving up is its own exit 97, which no edit produces, so the caller can
# say the useful part. The lock is taken on a file in the hub's own volume, beside the files it
# protects, and stdin passes through untouched because the bearer travels on it and must not appear in
# any command line.
hub_locked() {
  hub_exec_stdin sh -c '
    to=$1; lock=$2; shift 2
    exec 9>>"$lock" || exit 96
    flock -w "$to" 9 || exit 97
    "$@"
  ' sh "$HUB_LOCK_TIMEOUT" "$HUB_LOCK" "$@"
}

# One locked edit, with the wait explained. Hands back the command's own code, or 1 for a lock that
# stayed busy for the whole timeout.
hub_edit() {
  local rc=0
  hub_locked "$@" || rc=$?
  if [ "$rc" = 97 ]; then
    log "the hub's registry lock on $HUB_POD was held for ${HUB_LOCK_TIMEOUT}s by another edit, so this one stopped waiting. Run it again, or raise RIG_DISPATCH_HUB_LOCK_TIMEOUT."
    return 1
  fi
  return "$rc"
}

# Everything the hub's registry is, as one JSON object: the hosts.yaml entries, the names in hosts.d,
# and the aliases in host-bindings.json with the host id each one points at. A read, so it takes no
# lock -- a snapshot that a concurrent edit moves on is harmless, because hub-sync re-reads before it
# judges anything.
hub_inspect() {
  local root
  root=$(hub_npm_root)
  printf '%s%s\n' "$HUB_NODE_PRELUDE" '
const YAML = loadYaml();
let doc = {};
try { doc = YAML.parse(fs.readFileSync(yamlFile, "utf8")) || {}; } catch (e) { /* no registry yet */ }
const hosts = Array.isArray(doc.hosts) ? doc.hosts : [];
let dir = [];
try { dir = fs.readdirSync(path.join(home, "hosts.d")); } catch (e) { /* no bearer files yet */ }
// The sidecar as alias -> the host id it points at, not just the names. A name cannot say who owns an
// alias: a binding called t-something that points at a hand-made entry belongs to that entry, and an
// orphan pass reading only the names would delete a hand-made alias along with a real leftover.
let bindings = {};
try {
  const b = JSON.parse(fs.readFileSync(bindFile, "utf8")).bindings || {};
  for (const [k, v] of Object.entries(b)) bindings[k] = v && typeof v.hostId === "string" ? v.hostId : "";
} catch (e) { /* no sidecar */ }
// Which hosts the hub has a per-host subscription node for. Only the NAMES come from the config file,
// because the CLI has no verb that enumerates a dynamic key class; the VALUE stays on `rig config get`,
// the surface that owns it. Without this list a subscription left behind by a half-finished unregister
// is invisible, because nothing points at the host it belongs to any more.
let subs = [];
try {
  const cfg = JSON.parse(fs.readFileSync(path.join(home, "config.json"), "utf8"));
  const s = cfg && cfg.feed && typeof cfg.feed === "object" ? cfg.feed.subscriptions : null;
  if (s && typeof s === "object" && !Array.isArray(s)) subs = Object.keys(s);
} catch (e) { /* no config file, or no subscriptions written yet */ }
console.log(JSON.stringify({
  hosts: hosts.filter((h) => h && typeof h.id === "string").map((h) => ({
    id: h.id, transport: h.transport || "", url: h.url || "", bearer_file: h.bearer_file || "",
  })),
  bearerFiles: dir,
  bindings,
  subscriptions: subs,
}));
' | hub_exec_stdin env NPM_ROOT="$root" node -
}

# The per-host subscription is what makes the hub read that team's queue at all; a host without it is
# listed and shows no queue, which misleads in its own way. Read through the CLI rather than the
# settings file, because `config set` and `config reset` are what write it -- one definition of the
# setting, on the surface that owns it. Anything that is not exactly `true` counts as off, which covers
# unset, false and whatever the CLI prints for a key nobody ever set, without my guessing which.
hub_subscription() { # <host id> -> true | false
  local v=""
  # Belt and braces with `hub_exec`, which closes stdin for every hub read now. The live drain was
  # `sync_apply`'s repair calls: on a real cluster they drank the rest of the input `hub-sync` was
  # reading, because `kubectl exec -i` copies the caller's stdin into the pod whether or not the
  # command inside it ever reads.
  v=$(hub_exec rig config get "feed.subscriptions.$1.enabled" 2>/dev/null </dev/null | tail -n1) || true
  if [ "${v:-}" = true ]; then printf true; else printf false; fi
}

# What the hub holds in a bearer file, byte for byte -- `start` writes the token with no trailing
# newline, so this is the same bytes the team's Secret holds. A read, so it takes no lock, and a file
# that is not there or not readable is an empty answer rather than a failed one: the caller treats
# "not what the Secret holds" the same way whichever reason it was.
hub_bearer_contents() { hub_exec cat "$1" 2>/dev/null </dev/null || true; }

# There is no `rig host remove`, so hosts.yaml is edited directly, and host-bindings.json (the
# trust-on-first-use alias sidecar) is cleaned in the same pass:
#   HUB_MODE=has    exit 0 if HUB_HOST_ID is registered, 1 if it is not
#   HUB_MODE=remove drop that entry and its alias, rewriting each file via tmp + rename at 0600
hub_registry() {
  local mode=$1 host=$2 root runner
  root=$(hub_npm_root)
  # Reading needs no lock. Writing does: both writers read hosts.yaml, change it in memory and write
  # the whole file back, so the one that finishes last silently drops what the other just added.
  # Both branches take the node script on stdin, which is why `has` names the stdin-passing read.
  if [ "$mode" = has ]; then runner=hub_exec_stdin; else runner=hub_edit; fi
  printf '%s%s\n' "$HUB_NODE_PRELUDE" '
const mode = process.env.HUB_MODE, id = process.env.HUB_HOST_ID;
if (!fs.existsSync(yamlFile)) process.exit(mode === "has" ? 1 : 0);
const YAML = loadYaml();
const doc = YAML.parse(fs.readFileSync(yamlFile, "utf8")) || {};
const hosts = Array.isArray(doc.hosts) ? doc.hosts : [];
if (mode === "has") process.exit(hosts.some((h) => h && h.id === id) ? 0 : 1);
const kept = hosts.filter((h) => !(h && h.id === id));
if (kept.length !== hosts.length) {
  doc.hosts = kept;
  writeAtomic(yamlFile, YAML.stringify(doc));
}
// A leftover alias is harmless - a re-dispatched slug presents the same self-id - but it is
// residue, and "the hub forgot the team" should mean the hub forgot the team.
// The CLI has its own writer for this file (host-bindings.ts) and it takes a mkdir lock beside it, so
// an observation landing on the hub while this removal is in flight could rewrite the alias back. The
// same lock, held the same fail-open way: a busy lock must not turn a removal into a failure, and a
// resurrected alias is self-healing residue rather than corruption.
// (This script sits inside a single-quoted shell string, so it cannot carry apostrophes.)
try {
  const b = JSON.parse(fs.readFileSync(bindFile, "utf8"));
  if (b && b.bindings) {
    let n = 0;
    for (const [k, v] of Object.entries(b.bindings)) {
      if (k === id || (v && v.hostId === id)) { delete b.bindings[k]; n++; }
    }
    if (n > 0) {
      const lockDir = bindFile + ".lock";
      let locked = false;
      try { fs.mkdirSync(lockDir); locked = true; } catch (e) { /* held or unmakeable: rewrite anyway */ }
      try {
        writeAtomic(bindFile, JSON.stringify(b, null, 2) + "\n");
      } finally {
        if (locked) { try { fs.rmdirSync(lockDir); } catch (e) { /* best-effort, as the CLI does it */ } }
      }
    }
  }
} catch (e) { /* no sidecar, or unreadable: nothing to clean */ }
console.log(kept.length === hosts.length ? "absent" : "removed " + id);
' | "$runner" env NPM_ROOT="$root" HUB_MODE="$mode" HUB_HOST_ID="$host" node -
}

hub_register() {
  local slug=$1 ticket=$2 rig=$3
  local host bf sub
  host=$(name_of "$slug"); bf=$(hub_bearer_file "$slug"); sub="feed.subscriptions.$host.enabled"

  if ! hub_ready; then
    log "WARNING: no Ready hub pod $HUB_POD, so team $host is NOT registered with any hub: no hosts.yaml entry, no bearer file $bf, no $sub. The team works; the hub just does not see it. Re-run '$0 start $ticket' once the hub is Ready, or '$0 hub-sync' to register every team the hub is missing."
    return 0
  fi
  local url bearer
  url=$(hub_host_url "$slug")
  bearer=$(team_bearer "$slug")
  [ -n "$bearer" ] || die "secret $host has no bearer key; cannot register it with the hub"

  # The bearer travels on stdin, never in a command line the node can see.
  printf '%s' "$bearer" | hub_edit sh -c "umask 077; mkdir -p $(dirname "$bf"); cat > '$bf'; chmod 0600 '$bf'" \
    || die "could not write $bf in $HUB_POD; $host has no bearer file on the hub"

  if hub_registry has "$host" >/dev/null 2>&1; then
    log "hub already has host $host"
  else
    hub_edit rig host add --id "$host" --transport http --url "$url" --bearer-file "$bf" \
      --notes "ticket $ticket, rig ${rig:-none}" </dev/null >/dev/null \
      || die "the hub refused to register $host; it has a bearer file but no hosts.yaml entry"
    # Re-read rather than trust the verb: a subscription for a host missing from
    # hosts.yaml makes the hub report the team as unreachable forever.
    hub_registry has "$host" >/dev/null 2>&1 \
      || die "$host is still not in the hub's hosts.yaml after rig host add"
    log "registered $host with the hub at $url"
  fi
  # Without the subscription the hub lists the host but never reads its queue state, which is
  # as misleading as a missing host, so it fails the same way instead of being logged away.
  hub_edit rig config set "$sub" true </dev/null >/dev/null \
    || die "host $host is registered but $sub is not true: the hub will show it without its queue"
}

hub_unregister() {
  local slug=$1
  local host bf sub
  host=$(name_of "$slug"); bf=$(hub_bearer_file "$slug"); sub="feed.subscriptions.$host.enabled"

  if ! hub_ready; then
    log "WARNING: no Ready hub pod $HUB_POD, so $host is STILL registered with it. Once the hub is Ready, '$0 hub-sync' drops it again: the entry is stale there and no team StatefulSet backs it. If that is not enough, clean it by hand: drop the $host entry from ~/.openrig/hosts.yaml, run 'rig config reset $sub', and delete ~/.openrig/hosts.d/$host.bearer."
    return 0
  fi
  local ok=1
  # Stdout is noise here; stderr is not. The lock timeout is printed on stderr, and swallowing it would
  # turn "someone else is editing the hub" into a bare "could not", which is the least useful thing to
  # say about a failure the operator can do something about.
  hub_registry remove "$host" >/dev/null || { ok=0; log "could not remove $host from the hub's hosts.yaml or host-bindings.json"; }
  # `rig config reset` is the unset: it drops the whole feed.subscriptions.<host> node.
  hub_edit rig config reset "$sub" </dev/null >/dev/null || { ok=0; log "could not reset $sub on the hub"; }
  hub_edit rm -f "$bf" </dev/null >/dev/null || { ok=0; log "could not remove $bf from the hub"; }
  if [ "$ok" = 1 ]; then
    log "unregistered $host from the hub"
  else
    log "WARNING: $host is only partly unregistered; check hosts.yaml, $sub and $bf on $HUB_POD by hand"
  fi
}

# --- hub-sync ---------------------------------------------------------------------------------
#
# `start` and `delete` keep the hub's registry in step for the one ticket each is about, which holds
# only while nothing else removes a StatefulSet and every hub call each makes succeeds. When they do
# not -- the hub was not Ready, a StatefulSet went by way of `kubectl delete`, two edits interleaved --
# the registry and the cluster disagree for good and somebody repairs it by hand. This is that repair
# as a command: read the cluster, read the hub, make the two agree, and say what was found.
#
# Nothing calls it, on purpose. `start <ticket>` rewriting some other ticket's registration is a
# surprise with a large blast radius, and a command that did that could not keep its own exit codes;
# `watch --all` would pay a hub read forever to fix a drift that is rare. What the drift gets instead
# is to be announced where it is created -- the warnings in hub_register and hub_unregister name this
# command -- so the repair is one command away and stays a deliberate, named action.

# The plan's field separator. Not a tab: a tab is IFS whitespace, and `read` would collapse the empty
# field a team with no ticket handed over has, shifting every column after it one place to the left.
SYNC_SEP=$'\x1f'

# A slug `slug_of` could have produced. That is what makes a `t-` id the dispatcher's to reason about.
sync_is_slug() { printf '%s' "$1" | grep -Eq '^[a-z0-9][a-z0-9-]*$'; }

# One line per thing the registry says about the cluster, SYNC_SEP-separated:
#
#   finding  action  slug  host id  what was found
#
# finding is ok, missing, incomplete, stale, skip or foreign; action is register, complete, rewrite,
# unregister or none. The pass that plans the repairs and the pass that checks the result both come
# from here, so "the registry matches the cluster" is one definition rather than two that can drift.
# Three passes, one per place a registration can be recorded: every team the cluster has, every entry
# the hub's hosts.yaml has, and every leftover part the hub has with no entry to hang it on.
#
# Ownership, which is the part that could destroy something, is decided in two pieces. An entry whose
# id is a team's is owned because the cluster says so, whatever it currently holds -- so a team entry
# with a wrong url is repaired. An entry with no StatefulSet behind it has nothing vouching for it, so
# it is removed only when it is exactly what `start` writes and nothing else could plausibly be. A
# hand-made host is never touched, and a hand-made host that merely borrowed the `t-` naming is not
# touched either: a repair tool that deletes a person's entry is worse than one that leaves a stale
# row and says so.
sync_plan() { # <teams> <ready-map> <hub-state>
  local teams=$1 ready=$2 hub=$3
  local slug name qitem ticket rig state have url bf transport want_url want_bf why
  while IFS=$SYNC_SEP read -r slug name qitem ticket rig; do
    [ -n "$slug" ] || continue
    want_url=$(hub_host_url "$slug"); want_bf=$(hub_bearer_file "$slug")
    if [ -z "$qitem" ]; then
      printf 'skip\x1fnone\x1f%s\x1f%s\x1fno ticket handed over yet, so the hub has no business knowing it\n' "$slug" "$name"
      continue
    fi
    if [ "$(jq -r --arg n "$(pod_of "$slug")" '.[$n] // false' <<<"$ready")" != true ]; then
      printf 'skip\x1fnone\x1f%s\x1f%s\x1fhanded over but the pod is not Ready, so there is nothing to dial yet\n' "$slug" "$name"
      continue
    fi
    have=$(jq -c --arg id "$name" '.hosts[] | select(.id == $id)' <<<"$hub")
    if [ -z "$have" ]; then
      printf 'missing\x1fregister\x1f%s\x1f%s\x1fReady and handed over, but the hub has no %s entry\n' "$slug" "$name" "$name"
      continue
    fi
    url=$(jq -r '.url // ""' <<<"$have"); bf=$(jq -r '.bearer_file // ""' <<<"$have")
    transport=$(jq -r '.transport // ""' <<<"$have")
    if [ "$transport" != http ] || [ "$url" != "$want_url" ] || [ "$bf" != "$want_bf" ]; then
      printf 'incomplete\x1frewrite\x1f%s\x1f%s\x1fthe entry says transport [%s] url [%s] bearer_file [%s], not what start writes\n' \
        "$slug" "$name" "$transport" "$url" "$bf"
      continue
    fi
    # The bearer is what the hub dials with, and nothing rotates it: a Secret that changed, or a file
    # that went empty or unreadable, leaves an entry that reads as registered and authenticates as
    # refused. So the bytes are compared, not just the path.
    why=""
    if [ "$(jq -r --arg f "$name.bearer" 'if (.bearerFiles | index($f)) then "y" else "n" end' <<<"$hub")" != y ]; then
      why="no $want_bf file on the hub"
    elif [ "$(hub_bearer_contents "$want_bf")" != "$(team_bearer "$slug")" ]; then
      why="the bearer file on the hub is not what secret $name holds, so the hub cannot dial it"
    elif [ "$(hub_subscription "$name")" != true ]; then
      why="feed.subscriptions.$name.enabled is not true, so the hub shows it without its queue"
    fi
    if [ -n "$why" ]; then
      printf 'incomplete\x1fcomplete\x1f%s\x1f%s\x1f%s\n' "$slug" "$name" "$why"
    else
      printf 'ok\x1fnone\x1f%s\x1f%s\x1fregistered with the url, bearer and subscription start writes\n' "$slug" "$name"
    fi
  done < <(jq -r --arg u "$SYNC_SEP" '.[] | [.slug, .name, .qitem, .ticket, .rig] | join($u)' <<<"$teams")

  local id
  while IFS=$SYNC_SEP read -r id transport url bf; do
    [ -n "$id" ] || continue
    slug=${id#t-}
    if [ "$slug" = "$id" ]; then
      printf 'foreign\x1fnone\x1f-\x1f%s\x1fnot a team id at all, so not an entry the dispatcher wrote: left alone\n' "$id"
      continue
    fi
    if ! sync_is_slug "$slug"; then
      printf 'foreign\x1fnone\x1f-\x1f%s\x1fa t- id no ticket name could make: left alone\n' "$id"
      continue
    fi
    # A team that is still there was covered by the pass above, whatever its entry looks like now.
    if [ "$(jq -r --arg s "$slug" '[.[] | select(.slug == $s)] | length' <<<"$teams")" != 0 ]; then continue; fi
    if [ "$transport" = http ] && [ "$url" = "$(hub_host_url "$slug")" ] && [ "$bf" = "$(hub_bearer_file "$slug")" ]; then
      printf 'stale\x1funregister\x1f%s\x1f%s\x1fthe dispatcher wrote this entry and no team StatefulSet is behind it\n' "$slug" "$id"
    else
      printf 'foreign\x1fnone\x1f%s\x1f%s\x1fa t- id with a url, bearer path or transport start never writes: left alone\n' "$slug" "$id"
    fi
  done < <(jq -r --arg u "$SYNC_SEP" '.hosts[] | [.id, .transport // "", .url // "", .bearer_file // ""] | join($u)' <<<"$hub")

  # The third pass: the parts of a registration that are NOT a hosts.yaml entry. A team whose entry is
  # gone still has a bearer file, a subscription and an alias sitting on the hub, and the pass above
  # cannot see them because it walks hosts.yaml. That is not a curiosity: `hub_unregister` is three
  # independent steps and any one of them can fail -- a lock that stayed busy, for one -- and a failed
  # `delete` leaves precisely this. With no entry pointing anywhere, the only thing that vouches for a
  # part is its dispatcher-shaped name, so the bar is a `t-<slug>` name a ticket could have made, no
  # entry claiming it, and no StatefulSet behind it. "Claiming" is the wide question, not the narrow
  # one: an entry claims the id it holds, the bearer file it names and the alias that points back at
  # it, because those are the parts an unregister of that name would remove. That is what keeps a
  # hand-made host's files safe even when one of them is named like a team's, and it is what keeps the
  # four-field rule above as the only way a whole entry is ever removed.
  local part claimed
  while IFS= read -r id; do
    [ -n "$id" ] || continue
    slug=${id#t-}
    [ "$slug" != "$id" ] || continue
    sync_is_slug "$slug" || continue
    [ "$(jq -r --arg s "$slug" '[.[] | select(.slug == $s)] | length' <<<"$teams")" = 0 ] || continue
    # Is this part claimed by an entry that is still in hosts.yaml? An entry claims three names: its
    # own id, the bearer file it points at, and the alias whose binding points back at it. All three
    # have to be asked, because the shape that destroys something is the hand-made host that keeps its
    # token in a file named t-foo.bearer: the id t-foo has no entry of its own, so the file reads as a
    # leftover, and "finishing" it deletes a credential while the run reports a match. The file an
    # unregister would remove is exactly hub_bearer_file, so that is what an entry has to name to claim
    # it -- a file elsewhere with the same name is a different file.
    # Hands back "", or <kind>:<entry id> -- self (an entry holds the id), file (an entry names this
    # bearer file) or alias (this alias points at a live entry). self stays quiet: that entry has its
    # own row in the pass above, and an unregister of it takes these parts with it. file and alias are
    # said out loud, because a part that belongs to somebody else is worth naming rather than leaving a
    # person to wonder why a leftover is standing there.
    claimed=$(jq -r --arg id "$id" --arg bf "$(hub_bearer_file "$slug")" '
      (.bindings[$id] // "") as $bound
      | ([.hosts[] | select(.id == $id)      | .id] | first // "") as $byId
      | ([.hosts[] | select(.bearer_file == $bf) | .id] | first // "") as $byFile
      | ([.hosts[] | select(.id == $bound)   | .id] | first // "") as $byAlias
      | if   $byId != "" then "self:" + $byId
        elif $byFile != "" then "file:" + $byFile
        elif $byAlias != "" then "alias:" + $byAlias
        else "" end' <<<"$hub")
    case "$claimed" in
      self:*) continue ;;
      file:*)
        printf 'foreign\x1fnone\x1f%s\x1f%s\x1fthe bearer file %s is what entry %s dials with, so it is not a leftover at all: left alone\n' \
          "$slug" "$id" "$(hub_bearer_file "$slug")" "${claimed#file:}"
        continue ;;
      alias:*)
        printf 'foreign\x1fnone\x1f%s\x1f%s\x1fthe %s alias points at entry %s, so it is not a leftover at all: left alone\n' \
          "$slug" "$id" "$id" "${claimed#alias:}"
        continue ;;
    esac
    part=""
    if [ "$(jq -r --arg f "$id.bearer" 'if (.bearerFiles | index($f)) then "y" else "n" end' <<<"$hub")" = y ]; then
      part="the bearer file $(hub_bearer_file "$slug")"
    elif [ "$(jq -r --arg a "$id" 'if (.bindings | has($a)) then "y" else "n" end' <<<"$hub")" = y ]; then
      part="the $id alias in host-bindings.json"
    elif [ "$(hub_subscription "$id")" = true ]; then
      part="feed.subscriptions.$id.enabled"
    else
      continue
    fi
    printf 'stale\x1funregister\x1f%s\x1f%s\x1fno hosts.yaml entry and no team StatefulSet, and %s is left behind\n' \
      "$slug" "$id" "$part"
  done < <(jq -r '([.bearerFiles[] | select(endswith(".bearer")) | .[0:-7]] + (.bindings | keys) + .subscriptions
    | unique | .[])' <<<"$hub")
}

sync_verb() {
  case "$1" in
    register) printf 'registering it' ;;
    complete) printf 'completing it' ;;
    rewrite) printf 'rewriting it from scratch' ;;
    unregister) printf 'unregistering it' ;;
    *) printf '%s' "$1" ;;
  esac
}

sync_bad_count() { printf '%s\n' "$1" | awk -F"$SYNC_SEP" '
  BEGIN { n = 0 }
  $1 == "stale" || $1 == "missing" || $1 == "incomplete" { n++ }
  END { print n }'; }

# The cluster side of the plan, read into SYNC_TEAMS and SYNC_READY.
#
# A failed read is NOT an empty cluster, and here the difference is destructive: an empty team list
# makes every dispatcher-shaped entry look stale and unregisters all of them. `hub_ready` passing does
# not rule it out -- one pod GET can succeed while the list times out, is throttled, or is refused by
# RBAC -- so a failed read stops the run before it touches anything, the way `team_slugs` lets kubectl
# fail loudly. The pod list is held to the same bar: a failed read there only makes every team look
# not-Ready, which is safe but still lets the run end by claiming a registry matches a cluster it never
# read.
SYNC_TEAMS='[]'
SYNC_READY='{}'

sync_read_cluster() { # <stage, for the message> -> non-zero when nothing could be read
  local stage=$1 sts_list pod_list
  if ! sts_list=$(k get statefulsets -l "$ANN/role=team" -o json 2>&1); then
    echo "hub-sync: could not ${stage} the team StatefulSets in $NS: ${sts_list}" >&2
    return 1
  fi
  if ! pod_list=$(k get pods -l "$ANN/role=team" -o json 2>&1); then
    echo "hub-sync: could not ${stage} the team pods in $NS: ${pod_list}" >&2
    return 1
  fi
  SYNC_TEAMS=$(jq -c --arg a "$ANN" '[.items[] | {
      slug: (.metadata.labels[$a + "/ticket"] // ""),
      name: .metadata.name,
      qitem: (.metadata.annotations[$a + "/qitem"] // ""),
      ticket: (.metadata.annotations[$a + "/ticket-key"] // ""),
      rig: (.metadata.annotations[$a + "/rig"] // "")}]
    | map(select(.slug != ""))' <<<"$sts_list") || return 1
  SYNC_READY=$(jq -c '[.items[] | {(.metadata.name): (any(.status.conditions[]?; .type == "Ready" and .status == "True"))}] | add // {}' <<<"$pod_list") || return 1
}

# Still gone? The plan is a snapshot taken before the first edit, and a team can come back while the run
# is working -- a `delete` and a `start` of the same ticket is enough. Unregistering a team that exists
# again is the one mistake this command must never make, so the StatefulSet is checked again here, in
# the moment between deciding and doing.
#
# Only a NotFound answers "gone". A read that failed for another reason -- throttled, refused, a server
# that would not answer -- is not evidence that the team is absent, and treating it as though it were
# would unregister a team that is sitting right there, which is the same mistake the labelled list read
# used to make one level up. `--ignore-not-found -o name` prints nothing and exits 0 when the
# StatefulSet is missing and exits non-zero with the server's own words for every other failure, so the
# two are tellable apart. Hands back 0 gone, 1 still there, 2 could not tell.
sync_team_still_gone() { # <slug>
  local name out rc=0
  name=$(name_of "$1")
  out=$(k get statefulset "$name" --ignore-not-found -o name 2>&1) || rc=$?
  if [ "$rc" != 0 ]; then
    echo "hub-sync: could not re-check $name before unregistering it: ${out}" >&2
    return 2
  fi
  [ -z "$out" ]
}

# Each repair runs in a subshell because hub_register and hub_unregister `die` on what is fatal for
# them, and one team that will not register should not cancel the others off the list.
sync_apply() { # <action> <slug> <host id> <teams>
  local action=$1 slug=$2 host=$3 teams=$4 ticket rig
  ticket=$(jq -r --arg s "$slug" '.[] | select(.slug == $s) | .ticket' <<<"$teams")
  rig=$(jq -r --arg s "$slug" '.[] | select(.slug == $s) | .rig' <<<"$teams")
  case "$action" in
    register|complete) ( hub_register "$slug" "$ticket" "$rig" ) ;;
    rewrite) ( hub_unregister "$slug" ) && ( hub_register "$slug" "$ticket" "$rig" ) ;;
    unregister) ( hub_unregister "$slug" ) ;;
    *) return 1 ;;
  esac
}

cmd_hub_sync() {
  local dry=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry=1; shift ;;
      -*) die "unknown option $1" ;;
      *) die "hub-sync reconciles every team in $NS and takes no ticket (got '$1')" ;;
    esac
  done
  local teams ready

  # Before anything else, and it touches nothing: with no hub there is no registry to read, and
  # guessing at one from the cluster alone would mean writing to a hub that is not answering.
  if ! hub_ready; then
    echo "hub-sync: no Ready hub pod $HUB_POD in $NS, so nothing was read and nothing was changed."
    echo "hub-sync: the hub itself is what is missing. Once it is Ready, run '$0 hub-sync'."
    return 3
  fi

  local hub_state plan finding action slug host detail bad gone
  sync_read_cluster "read" || {
    echo "hub-sync: nothing was read and nothing was changed. A read that failed is not a cluster with no teams in it; run '$0 hub-sync' again once kubectl answers." >&2
    return 1
  }
  teams=$SYNC_TEAMS; ready=$SYNC_READY

  hub_state=$(hub_inspect) || { echo "hub-sync: could not read the registry from $HUB_POD" >&2; return 1; }
  echo "hub-sync: $HUB_POD is Ready: $(jq length <<<"$teams") team StatefulSet(s), $(jq '.hosts | length' <<<"$hub_state") entr(s) in its registry."
  if [ "$dry" = 1 ]; then echo "hub-sync: --dry-run, so nothing is changed."; fi

  plan=$(sync_plan "$teams" "$ready" "$hub_state")
  while IFS=$SYNC_SEP read -r finding action slug host detail; do
    [ -n "$finding" ] || continue
    if [ "$action" = none ]; then
      printf 'hub-sync: %-10s %-14s %s\n' "$finding" "$host" "$detail"
      continue
    fi
    # The plan is a snapshot, and the cluster can move while this run works -- a `delete` and a `start`
    # of the same ticket is enough. Unregistering a team that exists again is the one thing this command
    # must never do, so the StatefulSet is checked again in the moment between deciding and doing, and a
    # check that could not be made counts as "do not remove it" rather than as "it is gone".
    if [ "$action" = unregister ] && [ "$dry" != 1 ]; then
      gone=0
      sync_team_still_gone "$slug" || gone=$?
      if [ "$gone" = 2 ]; then
        printf 'hub-sync: %-10s %-14s %s\n' "skip" "$host" \
          "its team StatefulSet could not be checked again, so it was left registered"
        continue
      fi
      if [ "$gone" != 0 ]; then
        printf 'hub-sync: %-10s %-14s %s -- left alone: its team StatefulSet is back\n' \
          "skip" "$host" "the cluster moved while this run was working"
        continue
      fi
    fi
    if [ "$dry" = 1 ]; then
      printf 'hub-sync: %-10s %-14s %s -- would %s\n' "$finding" "$host" "$detail" "$(sync_verb "$action")"
      continue
    fi
    printf 'hub-sync: %-10s %-14s %s -- %s\n' "$finding" "$host" "$detail" "$(sync_verb "$action")"
    # </dev/null, and not only because a repair makes hub calls: the plan is this loop's own input, and
    # a repair that drank the caller's stdin would drink the rest of the plan with it. Every hub call
    # below keeps its own stdin for the same reason; this is the belt beside that braces.
    sync_apply "$action" "$slug" "$host" "$teams" </dev/null || echo "hub-sync: could not $action $host"
  done <<<"$plan"

  bad=$(sync_bad_count "$plan")
  if [ "$dry" = 1 ]; then
    if [ "$bad" = 0 ]; then
      echo "hub-sync: the registry already matches the teams in $NS; there is nothing to do."
      return 0
    fi
    echo "hub-sync: $bad difference(s) from the teams in $NS. Run '$0 hub-sync' without --dry-run to repair them."
    return 1
  fi

  # Re-read the hub rather than remember what it was just told, and re-read the cluster for the same
  # reason: a team that came back mid-run is not stale, and judging the result from the old snapshot
  # would report a difference that is not there. Nothing is counted good because the code wrote it, and
  # nothing is counted bad because a snapshot has gone stale.
  hub_state=$(hub_inspect) || { echo "hub-sync: could not re-read the registry from $HUB_POD to check the result" >&2; return 1; }
  sync_read_cluster "re-read" || { echo "hub-sync: could not re-read the teams in $NS to check the result" >&2; return 1; }
  teams=$SYNC_TEAMS; ready=$SYNC_READY
  plan=$(sync_plan "$teams" "$ready" "$hub_state")
  bad=$(sync_bad_count "$plan")
  if [ "$bad" = 0 ]; then
    echo "hub-sync: the hub's registry matches the teams in $NS."
    return 0
  fi
  echo "hub-sync: $bad difference(s) still stand, so the registry does not match the cluster:"
  printf '%s\n' "$plan" | awk -F"$SYNC_SEP" '
    $1 == "stale" || $1 == "missing" || $1 == "incomplete" { print "hub-sync:   " $1 " " $4 ": " $5 }'
  return 1
}

# --- start -------------------------------------------------------------------------------------

team_manifests() {
  # args: slug ticket repo ref spec image cpu memory storage envjson bearer
  jq -n --arg slug "$1" --arg ticket "$2" --arg repo "$3" --arg ref "$4" --arg spec "$5" \
    --arg image "$6" --arg cpu "$7" --arg mem "$8" --arg storage "$9" --argjson extra "${10}" \
    --arg bearer "${11}" --arg ann "$ANN" '
    ($slug | "t-" + .) as $name |
    {app: "openrig-team", ($ann + "/role"): "team", ($ann + "/ticket"): $slug} as $labels |
    {apiVersion: "v1", kind: "List", items: [
      {apiVersion: "v1", kind: "Secret", type: "Opaque",
       metadata: {name: $name, labels: $labels},
       stringData: {bearer: $bearer}},
      {apiVersion: "apps/v1", kind: "StatefulSet",
       metadata: {name: $name, labels: $labels,
         annotations: {($ann + "/ticket-key"): $ticket, ($ann + "/repo"): $repo, ($ann + "/ref"): $ref,
                       ($ann + "/spec"): $spec}},
       spec: {
         serviceName: "teams", replicas: 1,
         selector: {matchLabels: {($ann + "/ticket"): $slug}},
         persistentVolumeClaimRetentionPolicy: {whenDeleted: "Delete", whenScaled: "Retain"},
         template: {
           metadata: {labels: $labels},
           spec: {
             automountServiceAccountToken: false,
             securityContext: {runAsNonRoot: true, runAsUser: 1000, runAsGroup: 1000, fsGroup: 1000,
                               seccompProfile: {type: "RuntimeDefault"}},
             imagePullSecrets: [{name: "ghcr-pull"}],
             terminationGracePeriodSeconds: 60,
             containers: [{
               name: "daemon", image: $image,
               securityContext: {allowPrivilegeEscalation: false, capabilities: {drop: ["ALL"]}},
               ports: [{name: "daemon", containerPort: 7433}],
               env: ([
                 {name: "OPENRIG_HOST_NAME", value: $name},
                 {name: "OPENRIG_BIND_HOST", value: "0.0.0.0"},
                 {name: "OPENRIG_PORT", value: "7433"},
                 {name: "OPENRIG_NO_KERNEL", value: "1"},
                 {name: "OPENRIG_AUTH_BEARER_TOKEN",
                  valueFrom: {secretKeyRef: {name: $name, key: "bearer"}}},
                 {name: "OPENRIG_WORKSPACE_REPO", value: $repo},
                 {name: "GIT_USER_NAME", value: ("OpenRig team " + $name)}
               ]
               + (if $ref == "" then [] else [{name: "OPENRIG_WORKSPACE_REF", value: $ref}] end)
               + $extra),
               envFrom: [{secretRef: {name: "openrig-agents"}}],
               readinessProbe: {httpGet: {path: "/healthz", port: "daemon"}, periodSeconds: 10},
               resources: {requests: {cpu: $cpu, memory: $mem}, limits: {memory: $mem}},
               volumeMounts: [{name: "home", mountPath: "/home/openrig"},
                              {name: "kit", mountPath: "/etc/openrig-kit", readOnly: true}]
             }],
             volumes: [{name: "kit", configMap: {name: "openrig-kit", defaultMode: 292,
               items: [
                 {key: "rig.yaml", path: "rig.yaml"},
                 {key: "rig-one.yaml", path: "rig-one.yaml"},
                 {key: "lead-monitoring.md", path: "guidance/lead-monitoring.md"},
                 {key: "pi-seat-status", path: "bin/pi-seat-status", mode: 365},
                 {key: "openrig-heartbeat.ts", path: "pi-extensions/openrig-heartbeat.ts"},
                 {key: "models.json", path: "pi/models.json"}]}}]
           }
         },
         volumeClaimTemplates: [{metadata: {name: "home"},
           spec: {accessModes: ["ReadWriteOnce"], resources: {requests: {storage: $storage}}}}]
       }}
    ]}'
}

# KEY=VALUE lines -> a JSON env array. Values are taken verbatim.
env_json() {
  local out='[]' line
  for line in "$@"; do
    [[ "$line" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || die "bad --env '$line' (want NAME=VALUE)"
    out=$(jq -c --arg n "${line%%=*}" --arg v "${line#*=}" '. + [{name: $n, value: $v}]' <<<"$out")
  done
  printf '%s' "$out"
}

wait_ready() {
  local slug=$1 timeout=$2 pod deadline
  pod=$(pod_of "$slug"); deadline=$((SECONDS + timeout))
  until k get pod "$pod" >/dev/null 2>&1; do
    [ $SECONDS -lt $deadline ] || die "$pod was not created within ${timeout}s"
    sleep 2
  done
  log "waiting for $pod to be Ready"
  k wait --for=condition=Ready "pod/$pod" --timeout="$((deadline - SECONDS > 1 ? deadline - SECONDS : 1))s" >/dev/null \
    || die "$pod is not Ready; inspect it with: $KUBECTL -n $NS describe pod $pod"
}

# Brings the team's rig up, or back after a pod restart. Records the rig name on the StatefulSet.
ensure_rig() {
  local slug=$1 sts rig spec nodes out
  sts=$(sts_json "$slug"); rig=$(annotation "$sts" rig); spec=$(annotation "$sts" spec)
  if [ -z "$rig" ]; then
    log "rig up $spec"
    out=$(inpod "$slug" rig up "$spec" --yes --json) || die "rig up failed: $out"
    rig=$(jq -r '[.. | objects | .specName? // empty] | first // empty' <<<"$out")
    [ -n "$rig" ] || die "rig up gave no rig name: $(head -c 400 <<<"$out")"
    annotate "$slug" rig "$rig"
    return
  fi
  nodes=$(inpod "$slug" rig ps --nodes --rig "$rig" --json 2>/dev/null || echo '[]')
  if ! jq -e 'length > 0 and all(.[]; .sessionStatus == "running")' >/dev/null <<<"$nodes"; then
    log "restoring rig $rig"
    inpod "$slug" rig up "$rig" --existing --yes --json >/dev/null || die "restoring $rig failed"
  fi
}

lead_session() {
  local slug=$1 rig=$2 lead=$3
  inpod "$slug" rig ps --nodes --rig "$rig" --json |
    jq -r --arg l "$lead" '.[] | select(.logicalId == $l) | .canonicalSessionName' | head -1
}

brief_with_contract() {
  local slug=$1 file=$2
  cat "$file"
  cat <<EOF


---
Completion contract (from the dispatcher; follow it exactly):

1. Work in /home/openrig/work/project. Commit the change on branch ticket/$slug.
2. The change is complete only after your reviewer has approved it.
3. Then write $RESULT as JSON:
   {"status": "done" | "failed" | "needs-human", "branch": "ticket/$slug", "commit": "<sha>", "summary": "<what changed and how it was verified>"}
   Use "needs-human" when you need a decision; ask for it on the queue, and overwrite the file once you continue.
4. Close your queue items. Do not push; this pod has no Git credentials.
EOF
}

cmd_start() {
  local ticket="" repo="" ref="" spec=/etc/openrig-kit/rig.yaml brief="" image="${RIG_DISPATCH_IMAGE:-}"
  local cpu=500m mem=4Gi storage=20Gi lead=orch.lead ready_timeout=600
  local -a envs=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) repo=$2; shift 2 ;;
      --ref) ref=$2; shift 2 ;;
      --spec) spec=$2; shift 2 ;;
      --brief-file) brief=$2; shift 2 ;;
      --image) image=$2; shift 2 ;;
      --env) envs+=("$2"); shift 2 ;;
      --cpu) cpu=$2; shift 2 ;;
      --memory) mem=$2; shift 2 ;;
      --storage) storage=$2; shift 2 ;;
      --lead) lead=$2; shift 2 ;;
      --ready-timeout) ready_timeout=$2; shift 2 ;;
      -*) die "unknown option $1" ;;
      *) [ -z "$ticket" ] || die "one ticket at a time"; ticket=$1; shift ;;
    esac
  done
  [ -n "$ticket" ] || usage
  local slug sts
  slug=$(slug_of "$ticket")
  sts=$(sts_json "$slug" || true)

  if [ -z "$sts" ]; then
    [ -n "$repo" ] || die "--repo is required for a new ticket"
    [ -n "$brief" ] && [ -f "$brief" ] || die "--brief-file is required for a new ticket"
    [ -n "$image" ] || image=$(default_image)
    # Site defaults for the kit's rigs, e.g. which seats need Pi seeding.
    if [ -f "$HERE/team.env" ]; then
      while IFS= read -r line; do
        [[ -z "$line" || "$line" == \#* ]] || envs=("$line" "${envs[@]}")
      done < "$HERE/team.env"
    fi
    local bearer
    bearer=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')
    log "creating $(name_of "$slug") for $ticket ($image)"
    team_manifests "$slug" "$ticket" "$repo" "$ref" "$spec" "$image" "$cpu" "$mem" "$storage" \
      "$(env_json "${envs[@]}")" "$bearer" | k apply -f - >/dev/null
    unset bearer
  else
    log "$(name_of "$slug") exists; resuming"
  fi

  wait_ready "$slug" "$ready_timeout"
  ensure_rig "$slug"

  sts=$(sts_json "$slug")
  if [ -z "$(annotation "$sts" qitem)" ]; then
    [ -n "$brief" ] && [ -f "$brief" ] || die "--brief-file is required to hand over the ticket"
    local rig session qitem
    rig=$(annotation "$sts" rig)
    session=$(lead_session "$slug" "$rig" "$lead")
    [ -n "$session" ] || die "no seat '$lead' in rig $rig (use --lead <logicalId>)"
    brief_with_contract "$slug" "$brief" | inpod_stdin "$slug" sh -c "cat > $WORK/brief.md"
    qitem=$(inpod "$slug" rig queue create --source "dispatcher@$NS" --destination "$session" \
      --tags "ticket:$slug" --summary "$(annotation "$sts" ticket-key): $(head -n1 "$brief" | sed 's/^#* *//' | cut -c1-100)" \
      --body-file "$WORK/brief.md" --json | jq -r '.qitemId // .qitem.qitemId // empty')
    [ -n "$qitem" ] || die "queue create returned no qitem id"
    annotate "$slug" qitem "$qitem"
    annotate "$slug" lead "$lead"
    log "handed $ticket to $session as $qitem"
  fi
  # After the handover, on purpose: the hub is a view-only extra, and a hub that is Ready but
  # failing (pods/exec RBAC, a full volume, a hosts.yaml `rig host add` refuses) must never
  # leave a team running with no ticket. The failure is still loud and still exits non-zero.
  hub_register "$slug" "$ticket" "$(annotation "$(sts_json "$slug")" rig)"
  cmd_status "$ticket"
}

# --- status / wait ---------------------------------------------------------------------------

# One JSON object describing a ticket, read from the cluster and the pod.
probe() {
  local slug=$1 sts pod ready rig nodes items result
  sts=$(sts_json "$slug") || { jq -n --arg s "$slug" '{slug: $s, phase: "absent"}'; return; }
  pod=$(k get pod "$(pod_of "$slug")" -o json 2>/dev/null || echo '{}')
  ready=$(jq -r '[.status.conditions[]? | select(.type == "Ready") | .status] | first // "False"' <<<"$pod")
  rig=$(annotation "$sts" rig)
  nodes='[]' items='[]' result='null'
  if [ "$ready" = True ]; then
    [ -z "$rig" ] || nodes=$(inpod "$slug" rig ps --nodes --rig "$rig" --json 2>/dev/null || echo '[]')
    items=$(inpod "$slug" rig queue list -a -A -o json --limit 500 2>/dev/null |
      jq -c --arg t "ticket:$slug" '[.[] | select((.tags // []) | index($t))]' 2>/dev/null || echo '[]')
    result=$(inpod "$slug" sh -c "cat $RESULT 2>/dev/null; true" | jq -c . 2>/dev/null || echo 'null')
    [ -n "$result" ] || result=null
  fi
  jq -n --arg slug "$slug" --argjson sts "$sts" --argjson pod "$pod" --arg ready "$ready" \
    --arg rig "$rig" --argjson nodes "$nodes" --argjson items "$items" --argjson result "$result" --arg ann "$ANN" '
    {slug: $slug, ticket: $sts.metadata.annotations[$ann + "/ticket-key"], rig: $rig,
     qitem: $sts.metadata.annotations[$ann + "/qitem"], created: $sts.metadata.creationTimestamp,
     pod: ($pod.status.phase // "None"), ready: ($ready == "True"),
     seats: [$nodes[] | {seat: .logicalId, session: .canonicalSessionName, status: .sessionStatus,
                         activity: (.agentActivity.state // "unknown")}],
     open: [$items[] | select(.state as $s | ["pending", "in-progress", "blocked"] | index($s)) |
            {qitemId, state, destination: .destinationSession}],
     result: $result}
    | .phase = (if .result != null then "result:" + (.result.status // "?")
                elif .ready | not then "starting"
                elif .rig == "" then "ready"
                elif .qitem == null then "up"
                elif ([.seats[] | select(.status != "running")] | length) > 0 then "degraded"
                elif ([.open[] | select(.state == "blocked")] | length) > 0 then "blocked"
                else "working" end)'
}

team_slugs() {
  k get statefulsets -l "$ANN/role=team" -o json | jq -r --arg a "$ANN/ticket" '.items[].metadata.labels[$a]'
}

cmd_status() {
  local json=0 ticket="" slug
  while [ $# -gt 0 ]; do
    case "$1" in --json) json=1; shift ;; -*) die "unknown option $1" ;; *) ticket=$1; shift ;; esac
  done
  local -a slugs
  if [ -n "$ticket" ]; then slugs=("$(slug_of "$ticket")"); else mapfile -t slugs < <(team_slugs); fi
  local all='[]'
  for slug in "${slugs[@]}"; do
    [ -n "$slug" ] || continue
    all=$(jq -c --argjson p "$(probe "$slug")" '. + [$p]' <<<"$all")
  done
  if [ $json = 1 ]; then jq . <<<"$all"; return; fi
  jq -r '
    (["TICKET", "PHASE", "SEATS", "OPEN", "CREATED", "SUMMARY"] | @tsv),
    (.[] | [(.ticket // .slug), .phase,
            ([.seats[] | "\(.seat)=\(.activity)"] | join(",") | if . == "" then "-" else . end),
            (.open | length | tostring), (.created // "-"),
            ((.result.summary // "") | .[0:60])] | @tsv)' <<<"$all" | column -t -s $'\t'
}

# What changes while a team makes progress: its queue items and its workspace.
progress_fingerprint() {
  local slug=$1 p=$2
  { jq -c '[.open[] | [.qitemId, .state, .destination]]' <<<"$p"
    inpod "$slug" sh -c "cd $WORK/project && git rev-parse HEAD && git status --porcelain && git diff | md5sum" 2>/dev/null
  } | md5sum | cut -d' ' -f1
}

# A seat can sit in a dead loop while its lead idles, and nothing inside the team notices (an idle
# agent does not wake up to check on others). After --stall minutes without progress, nudge the lead.
nudge_lead() {
  local slug=$1 minutes=$2 sts session
  sts=$(sts_json "$slug")
  session=$(lead_session "$slug" "$(annotation "$sts" rig)" "$(annotation "$sts" lead || true)")
  [ -n "$session" ] || session=$(lead_session "$slug" "$(annotation "$sts" rig)" orch.lead)
  [ -n "$session" ] || { log "no lead seat to nudge"; return; }
  inpod "$slug" rig send "$session" "From the dispatcher: no progress on this ticket for $minutes minutes (queue items, HEAD and working tree unchanged). Check every seat now: is one stuck in a loop, waiting on something that already finished, or waiting for a decision? Unblock it, or write $RESULT with status needs-human and the question." >/dev/null 2>&1 \
    && log "nudged $session after $minutes minutes without progress" || log "could not nudge $session"
}

cmd_wait() {
  local ticket="" timeout=7200 interval=30 stall=20
  while [ $# -gt 0 ]; do
    case "$1" in --timeout) timeout=$2; shift 2 ;; --interval) interval=$2; shift 2 ;;
      --stall) stall=$2; shift 2 ;;
      -*) die "unknown option $1" ;; *) ticket=$1; shift ;; esac
  done
  [ -n "$ticket" ] || usage
  local slug deadline p phase last="" fp prev_fp="" since=$SECONDS
  slug=$(slug_of "$ticket"); deadline=$((SECONDS + timeout))
  while :; do
    p=$(probe "$slug"); phase=$(jq -r .phase <<<"$p")
    [ "$phase" = "$last" ] || log "$ticket: $phase"; last=$phase
    case "$phase" in
      absent) die "$ticket has no team" ;;
      result:done) jq .result <<<"$p"; return 0 ;;
      result:needs-human) jq .result <<<"$p"; return 3 ;;
      result:*) jq .result <<<"$p"; return 1 ;;
      degraded) ensure_rig "$slug" ;;
      working|blocked)
        fp=$(progress_fingerprint "$slug" "$p")
        if [ "$fp" != "$prev_fp" ]; then prev_fp=$fp; since=$SECONDS
        elif [ $((SECONDS - since)) -ge $((stall * 60)) ]; then
          nudge_lead "$slug" "$(((SECONDS - since) / 60))"; since=$SECONDS
        fi ;;
    esac
    [ $SECONDS -lt $deadline ] || { log "timed out after ${timeout}s"; return 4; }
    sleep "$interval"
  done
}

# --- watch -------------------------------------------------------------------------------------
#
# `wait` learns what a team did by asking again every 30s. The team's own daemon already publishes
# its queue state machine as server-sent events on /api/events, so `watch` listens instead and
# reacts when a queue item reaches a terminal state or a human is needed. Polling stays here as the
# fallback for a pod that will not hold a stream, not the way this normally works.
#
# Resume. The last event id seen is stored per ticket INSTANCE -- together with the qitem id `start`
# writes -- and sent back as Last-Event-ID, so a dropped stream or a restarted watcher continues where
# it stopped instead of from the beginning. The team daemon replays from its own database -- an
# append-only events table whose ids are never reused -- so on one volume replay reaches everything
# since the first event, including across a daemon restart.
#
# What a stored id cannot do is tell a fresh volume from a quiet stream. A pod that came back on a new
# volume starts its ids again at 1, and the daemon replays only seq > the id it was given, so it sends
# nothing at all until its own ids pass that number: the stream goes silent, it does not come back
# short. So "an id that fails to move forward" cannot be observed from the stream (the daemon drops
# those rows itself) and a hole in an AUTOINCREMENT range with no deletes cannot be produced. Both are
# still checked, because they cost nothing and a future daemon could change that, but neither is what
# the watch relies on. What bounds every case where the events do not arrive is the backstop: a slow
# status read, run while the stream is quiet, which reports the ticket however it stands. A quiet
# stream is not evidence of anything on its own, so it is left alone until a backstop is due.
#
# A queue item reaching a terminal state is not the ticket finishing: seats close rows at every
# handoff. The ticket's verdict is its result file, which no event carries, so the phase a watch
# reports comes from the same read `status` uses -- one definition, not a second one invented here.

WATCH_DIR="${RIG_DISPATCH_WATCH_DIR:-$HOME/.rig-dispatch/watch}"
EVENTS_URL="${RIG_DISPATCH_EVENTS_URL:-http://127.0.0.1:7433/api/events}"
# How long one read waits before looking again at whether the ticket has its verdict. A stream that
# is quiet is not a stream that ended, so this is a check interval and not a timeout on the ticket.
WATCH_TICK="${RIG_DISPATCH_WATCH_TICK:-1}"
# How often a quiet stream gets a status read anyway. Events are the primary path; this is what
# bounds the cases where the event that would have ended the watch never comes.
WATCH_BACKSTOP="${RIG_DISPATCH_WATCH_BACKSTOP:-180}"
# The in-pod curl's own ceiling. A reader whose kubectl died cannot outlive it for long, and resume
# makes the reconnect free, so a bounded stream costs nothing but a short gap.
EVENTS_MAX_TIME="${RIG_DISPATCH_EVENTS_MAX_TIME:-300}"

W_LAST=0; W_BASE=0; W_FRESH=1; W_GAP=""; W_PHASE=""; W_SAW=0; W_QITEM=""; W_RC=0
W_DEADLINE=0; W_LASTPROBE=0; W_PIDFILE=""; W_TOKEN=""

watch_file() { printf '%s/%s.id' "$WATCH_DIR" "$1"; }

# The store holds "<qitem> <id>". An id is only worth resuming for the ticket instance that wrote it:
# a ticket key that is deleted and started again gets a fresh event store beginning at 1, and resuming
# the old high id there would make the daemon replay nothing at all -- the new team's events would all
# land below the number the watcher insisted on. So a stored id from another instance is dropped.
watch_last_id() { # <slug> <qitem>
  local f v="" q=""
  f=$(watch_file "$1")
  if [ -f "$f" ]; then read -r q v <"$f" 2>/dev/null || true; fi
  v=$(printf '%s' "$v" | tr -dc '0-9'); [ -n "$v" ] || v=0
  if [ "$v" != 0 ] && [ "$q" != "$2" ]; then
    log "$2: the stored id $v belongs to ticket instance ${q:-none}, not ${2:-none}, so this watch starts from 0"
    v=0
  fi
  printf '%s' "$v"
}

watch_save_id() { # <slug> <qitem> <id>
  printf '%s %s\n' "$2" "$3" >"$(watch_file "$1")" 2>/dev/null ||
    log "watch: could not store event id $3 for $1"
}

# Stops the reader this watch started: the `kubectl exec` and, through it, the curl inside the pod.
# Killing kubectl does not reach the in-pod curl -- that half is bounded by --max-time -- but it does
# stop the local reader from outliving the watch that made it. The recorded pid is the subshell that
# ran the stream, and kubectl is its child, so the child goes first: that is also what lets the
# substitution report the stream's exit status on the way out instead of being cut off before it did.
watch_stop_reader() {
  local p i=0 slug=${1:-}
  if [ -n "$slug" ]; then watch_reap_inpod "$slug"; fi
  [ -n "$W_PIDFILE" ] && [ -f "$W_PIDFILE" ] || return 0
  p=$(head -n1 "$W_PIDFILE" 2>/dev/null | tr -dc '0-9')
  [ -n "$p" ] || return 0
  if pkill -P "$p" >/dev/null 2>&1; then :; else kill "$p" 2>/dev/null || return 0; fi
  while [ "$i" -lt 10 ] && kill -0 "$p" 2>/dev/null; do sleep 0.1; i=$((i + 1)); done
  kill "$p" 2>/dev/null
  return 0
}

# One SSE stream over pod-local loopback -- the same path every other command uses to reach the
# team daemon, and the same posture: an IP-literal Host needs no bearer. The stream is deliberately
# unfiltered, because the daemon stores queue events with no rig id, so a ?rigId= query would
# replay none of them.
#
# The reader header names this watcher's own curl to the reap below. Killing `kubectl exec` does not
# reach the process it started inside the pod, and a curl on a quiet stream never writes, so it never
# notices its stdout has gone away and simply stays open on the team's daemon. The token is per watch,
# so reaping one watcher's reader cannot disturb another's on the same pod.
watch_stream() {
  local slug=$1 last=$2
  local -a hdr=(-H 'Accept: text/event-stream' -H "X-Rig-Dispatch-Reader: $W_TOKEN")
  if [ "$last" -gt 0 ]; then hdr+=(-H "Last-Event-ID: $last"); fi
  inpod "$slug" curl -sS -N -f --connect-timeout 10 --max-time "$EVENTS_MAX_TIME" \
    "${hdr[@]}" "$EVENTS_URL"
}

# Reaps the in-pod half of the reader. Best effort: if this cannot be done the curl still dies on its
# own --max-time, which is why that bound stays even though it is the slow answer.
watch_reap_inpod() { # <slug>
  local slug=$1
  [ -n "$W_TOKEN" ] || return 0
  # The bracket is not decoration: without it the pattern matches the very shell running it.
  inpod "$slug" sh -c "pkill -f 'X-Rig-Dispatch-[R]eader: $W_TOKEN' >/dev/null 2>&1 || true" \
    </dev/null 2>/dev/null || true
  return 0
}

# Reads one stream until it ends, the ticket has its verdict, or the watch runs out of time.
#
# All three have to be able to end the read on their own. A team's stream stays open for as long as the
# pod does, so a read that ran to the end of the stream would sit there after the terminal event with
# nothing left to arrive, and would sit there forever if no event ever came. So each read is given
# WATCH_TICK seconds, and a read that times out is the only moment there is to ask the two questions
# that matter: is the answer already in (stop), and is the deadline or a backstop due (act, then stop
# or keep waiting). A timeout is not the end of the stream either, and a line cut in half by one is
# kept in $line rather than dropped.
#
# Bash reads from a process substitution rather than a pipe so the ids it stores outlive the loop,
# and the stream's exit status comes back through a file. The substitution records the pid of the
# reader it backgrounded, because nothing else can reach it afterwards: a substitution is not a job,
# so it is not in $! and not in the shell's job table.
watch_read() { # <slug> <ticket> <rcfile>
  local slug=$1 ticket=$2 rcfile=$3
  local line="" chunk="" id="" data="" rc sp sp_rc
  W_FRESH=1; W_SAW=0
  while :; do
    chunk=""
    IFS= read -r -t "$WATCH_TICK" chunk
    rc=$?
    line="$line$chunk"
    if [ "$rc" -gt 128 ]; then          # timed out: the stream is open and quiet
      [ -n "$W_PHASE" ] && break        # the ticket has its verdict: stop watching
      [ "$SECONDS" -lt "$W_DEADLINE" ] || break   # the deadline is honoured mid-stream
      if [ "$WATCH_BACKSTOP" -gt 0 ] && [ $((SECONDS - W_LASTPROBE)) -ge "$WATCH_BACKSTOP" ]; then
        W_LASTPROBE=$SECONDS
        watch_reconcile "$slug" "$ticket" "backstop"
      fi
      continue                          # otherwise keep waiting on the same stream
    fi
    [ "$rc" = 0 ] || break              # EOF or a dead stream: whatever is left is not a line
    case "$line" in
      id:*) id=${line#id:}; id=${id//[[:space:]]/} ;;
      data:*) data=${line#data:}; data=${data# } ;;
      '')
        if [ -n "$data" ]; then
          watch_event "$slug" "$ticket" "$id" "$data"
          id=""; data=""
        fi ;;
    esac
    line=""
  # `wait "$sp"` and not a bare `wait`: with no operand bash waits for everything and returns 0, which
  # would report a stream that died at once as a stream that ended cleanly, and hide the case the
  # polling fallback exists for. And the status is captured with `|| sp_rc=$?` rather than read from
  # `$?`, because a bare failing `wait` under `set -e` ends this subshell before it can write it.
  done < <(watch_stream "$slug" "$W_BASE" & sp=$!; printf '%s' "$sp" >"$W_PIDFILE"; \
           sp_rc=0; wait "$sp" || sp_rc=$?; printf '%s' "$sp_rc" >"$rcfile")
  # Whatever ended the loop, the reader is this watch's own process and it does not get to outlive it.
  watch_stop_reader "$slug"
}

# One status read, through the same probe `status` uses, so what a watch reports is what `status`
# would say at that moment. Sets W_PHASE once the ticket has a verdict.
watch_reconcile() {
  local slug=$1 ticket=$2 why=$3 p phase
  p=$(probe "$slug") || { log "$ticket: the status read failed during the $why check"; return 0; }
  phase=$(jq -r '.phase // "?"' <<<"$p")
  case "$phase" in
    result:*) W_PHASE=$phase; log "$ticket: $phase ($why)"; jq .result <<<"$p" ;;
    absent) W_PHASE=absent; log "$ticket: the team is gone ($why)" ;;
    *) log "$ticket: $phase ($why)" ;;
  esac
}

watch_event() { # <slug> <ticket> <event id> <json>
  local slug=$1 ticket=$2 id=$3 data=$4
  case "$id" in ''|*[!0-9]*) return 0 ;; esac
  watch_handle "$slug" "$ticket" "$id" "$data"
  # Stored only after the event has been acted on, the status read it may have triggered included. A
  # watcher killed mid-reconcile must replay this event when it comes back, not be told it already saw
  # it: probe takes several kubectl round trips, which is long enough to be killed inside.
  watch_save_id "$slug" "$W_QITEM" "$id"
}

watch_handle() { # <slug> <ticket> <event id> <json>
  local slug=$1 ticket=$2 id=$3 data=$4
  local prev=$W_LAST
  if [ "$id" -le "$prev" ]; then
    W_GAP="event id $id did not move past $prev, so the team's event store was replaced"
  elif [ "$W_FRESH" = 1 ] && [ "$prev" -gt 0 ] && [ "$id" -gt $((prev + 1)) ]; then
    W_GAP="replay resumed at $id, not at $((prev + 1)), so the events between them are gone from the team's store"
  fi
  W_FRESH=0; W_SAW=1; W_LAST=$id
  # The gap path answers with a status read instead of the event, which is the stronger of the two:
  # it reports the ticket as it is now, so the event that revealed the gap cannot be missed.
  if [ -n "$W_GAP" ]; then
    log "$ticket: replay gap: $W_GAP; falling back to one status poll"
    W_GAP=""
    watch_reconcile "$slug" "$ticket" "replay gap"
    return 0
  fi
  local type to from qitem kind
  type=$(jq -r '.type // ""' <<<"$data" 2>/dev/null) || return 0
  case "$type" in queue.*) ;; *) return 0 ;; esac
  to=$(jq -r '.toState // ""' <<<"$data")
  from=$(jq -r '.fromState // ""' <<<"$data")
  qitem=$(jq -r '.qitemId // ""' <<<"$data")
  case "$to" in
    done|handed-off|canceled|failed|denied) kind=terminal ;;
    blocked) kind=human ;;
    *) return 0 ;;
  esac
  if [ "$kind" = terminal ]; then
    log "$ticket: queue item $qitem reached $to (from ${from:-?})"
  else
    log "$ticket: queue item $qitem is blocked (from ${from:-?}): a human may be needed"
  fi
  # Only these two can end a ticket: its own row closing, or the team stopping for a person. Other
  # rows close at every handoff while the ticket is still running.
  if [ "$qitem" = "$W_QITEM" ] || [ "$kind" = human ]; then
    watch_reconcile "$slug" "$ticket" "$kind"
  fi
}

# Watches one ticket to its verdict. Exit codes are `wait`'s: 0 done, 3 needs a human, 1 any other
# failure, 4 timeout.
watch_ticket() { # <slug> <ticket> <collect 0|1> <archive> <timeout> <interval> <reconnect>
  local slug=$1 ticket=$2 do_collect=$3 archive=$4 timeout=$5 interval=$6 reconnect=$7
  local sts key fails=0 started rc=1 crc=0 tmpd rcfile
  sts=$(sts_json "$slug" || true)
  [ -n "$sts" ] || die "$ticket has no team"
  key=$(annotation "$sts" ticket-key); [ -n "$key" ] || key=$ticket
  W_QITEM=$(annotation "$sts" qitem)
  W_TOKEN=$(head -c 8 /dev/urandom | od -An -tx1 | tr -d ' \n')
  W_LAST=$(watch_last_id "$slug" "$W_QITEM")
  W_PHASE=""
  W_DEADLINE=$((SECONDS + timeout)); W_LASTPROBE=$SECONDS
  tmpd=$(mktemp -d)
  rcfile="$tmpd/rc"; W_PIDFILE="$tmpd/reader.pid"
  # Killed rather than finished: the reader is a child of this shell's process substitution, so it is
  # reachable only from here. Under --all each team runs in its own subshell and sets its own trap.
  trap 'watch_stop_reader "$slug"; rm -rf "$tmpd"' INT TERM
  log "$key: watching events from id $W_LAST (stored in $(watch_file "$slug"))"
  while :; do
    W_BASE=$W_LAST
    started=$SECONDS
    watch_read "$slug" "$key" "$rcfile" || true    # `|| true` is load-bearing: under `set -e` a failed command substitution in an assignment kills
    # the script, and there is no rc file at all when this watch stopped the stream itself.
    W_RC=$(cat "$rcfile" 2>/dev/null || true); [ -n "$W_RC" ] || W_RC=0
    [ -z "$W_PHASE" ] || break
    [ "$SECONDS" -lt "$W_DEADLINE" ] || { log "$key: timed out after ${timeout}s"; rm -rf "$tmpd"; return 4; }
    # A stream that will not stay open at all is not a stream: three attempts, then the polling read.
    # A curl that ran the whole --max-time is not one of those -- it had a working connection and a
    # quiet stream, which is the normal case -- so only a stream that died quickly counts here.
    if [ "$W_SAW" = 0 ] && [ "$W_RC" != 0 ] && [ "$((SECONDS - started))" -lt "$EVENTS_MAX_TIME" ]; then
      fails=$((fails + 1))
      if [ "$fails" -ge 3 ]; then
        log "$key: the events stream would not stay open ($fails attempts, last exit $W_RC); falling back to polling"
        rc=0
        cmd_wait "$ticket" --timeout "$((W_DEADLINE - SECONDS))" --interval "$interval" || rc=$?
        rm -rf "$tmpd"; trap - INT TERM
        return $rc
      fi
    else
      fails=0
    fi
    sleep "$reconnect"
  done
  rm -rf "$tmpd"; trap - INT TERM
  case "$W_PHASE" in
    result:done) rc=0 ;;
    result:needs-human) rc=3 ;;
    *) rc=1 ;;
  esac
  if [ "$W_PHASE" = result:done ] && [ "$do_collect" = 1 ]; then
    if [ -n "$archive" ]; then cmd_collect "$ticket" --archive "$archive" || crc=$?
    else cmd_collect "$ticket" || crc=$?; fi
    if [ "$crc" != 0 ]; then log "$key: collect failed (exit $crc)"; rc=$crc; fi
  fi
  return $rc
}

cmd_watch() {
  local ticket="" all=0 do_collect=0 archive="" timeout=7200 interval=30 reconnect=3
  while [ $# -gt 0 ]; do
    case "$1" in
      --all) all=1; shift ;;
      --collect) do_collect=1; shift ;;
      --archive|--dir) archive=$2; shift 2 ;;
      --timeout) timeout=$2; shift 2 ;;
      --interval) interval=$2; shift 2 ;;
      --reconnect) reconnect=$2; shift 2 ;;
      --state-dir) WATCH_DIR=$2; shift 2 ;;
      -*) die "unknown option $1" ;;
      *) [ -z "$ticket" ] || die "one ticket at a time"; ticket=$1; shift ;;
    esac
  done
  mkdir -p "$WATCH_DIR" 2>/dev/null || die "cannot create the watch state directory $WATCH_DIR"
  if [ "$all" = 1 ]; then
    [ -z "$ticket" ] || die "--all takes no ticket"
    local -a slugs=() pids=()
    mapfile -t slugs < <(team_slugs)
    [ "${#slugs[@]}" -gt 0 ] || die "no team pods in $NS"
    local s p rc=0
    for s in "${slugs[@]}"; do
      [ -n "$s" ] || continue
      watch_ticket "$s" "$s" "$do_collect" "$archive" "$timeout" "$interval" "$reconnect" &
      pids+=($!)
    done
    trap 'for p in "${pids[@]}"; do kill "$p" 2>/dev/null; done' INT TERM   # each child kills its own reader
    for p in "${pids[@]}"; do wait "$p" || rc=$?; done
    trap - INT TERM
    return $rc
  fi
  [ -n "$ticket" ] || usage
  watch_ticket "$(slug_of "$ticket")" "$ticket" "$do_collect" "$archive" "$timeout" "$interval" "$reconnect"
}

# --- archive ---------------------------------------------------------------------------------
#
# A team's whole history lives on its own pod volume and is deleted with the pod, so `archive`
# copies out everything that explains the ticket while the pod is still there. Every part is saved
# on its own and named in manifest.json with its row count or its error: one unreadable part costs
# that part, never the archive. Nothing here is swallowed the way `|| true` swallowed a failed
# usage read -- a part that could not be read is written down as not read.
#
# The reads are the daemon's own, over loopback inside the pod: `rig` for the CLI-backed streams,
# and the same loopback with the pod's own bearer for the audit rows, which have no CLI verb.

ARCHIVE_ROOT_DEFAULT=./tickets
QUEUE_LIMIT="${RIG_DISPATCH_QUEUE_LIMIT:-100000}"
MAX_PAGES="${RIG_DISPATCH_MAX_PAGES:-100000}"   # an opt-in ceiling, not a normal failure: termination comes from the cursor contract
AUDIT_PAGE=200     # the audit browse clamps anything larger to 200 anyway
TELEMETRY_PAGE=128 # the telemetry v1 contract caps a page at 128 source rows
USAGE_PAGE="${RIG_DISPATCH_USAGE_PAGE:-5000}"  # the public usage read caps a reply at 10,000 rows oldest-first and says nothing when it does

# Where the archives live: --dir wins, then the environment, then ./tickets.
archive_root() { printf '%s' "${1:-${RIG_DISPATCH_ARCHIVE_DIR:-$ARCHIVE_ROOT_DEFAULT}}"; }

PARTS='[]'
SCRATCH=""
PART_ERR=""

part_ok() { # part_ok <name> <rows> [note]
  PARTS=$(jq -c --arg n "$1" --argjson r "${2:-null}" --arg note "${3:-}" \
    '. + [{name: $n, ok: true, rows: $r} + (if $note == "" then {} else {note: $note} end)]' <<<"$PARTS")
}

part_failed() { # part_failed <name> <error>
  PARTS=$(jq -c --arg n "$1" --arg e "$2" \
    '. + [{name: $n, ok: false, rows: null, error: $e}]' <<<"$PARTS")
}

# Row count whatever shape a payload came in as: a list is its length, an object carrying rows or
# items is the length of those, and any other single document counts as one row.
rows_of() {
  jq -r 'if type == "array" then length
         elif type == "object" then
           (if (((.rows? // .items?) // null) | type) == "array" then ((.rows // .items) | length) else 1 end)
         else 0 end' "$1"
}

# save_part <name> <dest> <producer> [args...] -- run the producer, keep its stdout only when it is
# JSON. A failed command or junk output fails the part and leaves no file behind, so the archive
# never holds a part that looks saved and is not. The failure is recorded in PARTS rather than
# returned, because one unreadable part must not abort the run: everything else is still saved.
save_part() {
  local name=$1 dest=$2 producer=$3; shift 3
  local out e
  PART_ERR=""
  out=$(mktemp "$SCRATCH/part.XXXXXX")
  if ! "$producer" "$@" >"$out" 2>"$SCRATCH/part-err"; then
    e=${PART_ERR:-$(head -c 300 "$SCRATCH/part-err" | tr '\n\r' '  ')}
    part_failed "$name" "${e:-the command exited non-zero with no message}"; rm -f "$out"; return 0
  fi
  if ! jq -e . "$out" >/dev/null 2>&1; then
    part_failed "$name" "output is not JSON: $(head -c 200 "$out" | tr '\n\r' '  ')"; rm -f "$out"; return 0
  fi
  mv "$out" "$dest"
  part_ok "$name" "$(rows_of "$dest")"
}

# Coverage status across pages, worst seen wins: a later complete page must not hide an earlier
# partial one, because report reads this field to decide whether the history may be short.
worst_coverage() { # worst_coverage <current> <new>
  local rank_a rank_b
  case "$1" in retained_window) rank_a=0 ;; partial) rank_a=1 ;; *) rank_a=2 ;; esac
  case "$2" in retained_window) rank_b=0 ;; partial) rank_b=1 ;; *) rank_b=2 ;; esac
  if [ "$rank_b" -gt "$rank_a" ]; then printf '%s' "$2"; else printf '%s' "$1"; fi
}

# One telemetry stream, paged to the end. `rig telemetry` reads a single page and prints the cursor
# rather than following it, so following it here is the only way past 128 source rows. `--start
# retained` is what makes the first page begin at the retained floor: without it the stream opens at
# the high watermark and reads no history at all. A cursor that stops advancing is recorded as
# stalled rather than passed off as the whole history; the page budget sits on top of that as an
# opt-in limit and names itself when it is what ran out.
read_telemetry() { # read_telemetry <slug> <events|transitions>
  local slug=$1 stream=$2 cursor="" pages=0 stalled=false overbudget=false
  local status="retained_window" last="" next scanned rows_total=0 gapcount=0 watermark="" w
  : > "$SCRATCH/rows.jsonl"; : > "$SCRATCH/gaps.jsonl"
  while :; do
    local -a args=(--limit "$TELEMETRY_PAGE" --json)
    if [ -n "$cursor" ]; then args+=(--cursor "$cursor"); else args+=(--start retained); fi
    if ! inpod "$slug" rig telemetry "$stream" "${args[@]}" >"$SCRATCH/page" 2>"$SCRATCH/page-err"; then
      PART_ERR=$(head -c 300 "$SCRATCH/page-err" | tr '\n\r' '  '); return 1
    fi
    if ! jq -e . "$SCRATCH/page" >/dev/null 2>&1; then
      PART_ERR="page $((pages + 1)) is not JSON: $(head -c 200 "$SCRATCH/page" | tr '\n\r' '  ')"; return 1
    fi
    jq -c '.rows[]?' "$SCRATCH/page" >> "$SCRATCH/rows.jsonl"
    jq -c '.coverage.gaps[]?' "$SCRATCH/page" >> "$SCRATCH/gaps.jsonl"
    rows_total=$((rows_total + $(jq -c '(.rows // []) | length' "$SCRATCH/page")))
    # gapCount is the true count; coverage.gaps carries at most 32 detail rows per page.
    gapcount=$((gapcount + $(jq -r '.coverage.gapCount // 0' "$SCRATCH/page")))
    status=$(worst_coverage "$status" "$(jq -r '.coverage.status // "unknown"' "$SCRATCH/page")")
    # R3: `through` is fixed when the window opens and is the last row this read can include, so it is
    # what the archive actually holds. `retainedHighWatermark` is recomputed per page and can sit past
    # the last row read when the team writes during a multi-page read.
    w=$(jq -r '.page.through // ""' "$SCRATCH/page")
    if [ -n "$w" ]; then watermark=$w; fi
    pages=$((pages + 1))
    [ "$(jq -r '.page.hasMore' "$SCRATCH/page")" = true ] || break
    scanned=$(jq -r '.page.lastScanned // ""' "$SCRATCH/page")
    next=$(jq -r '.page.nextCursor // ""' "$SCRATCH/page")
    if [ -z "$next" ] || [ "$next" = "$cursor" ] || [ "$scanned" = "$last" ]; then stalled=true; break; fi
    cursor=$next; last=$scanned
    [ "$pages" -lt "$MAX_PAGES" ] || { overbudget=true; break; }
  done
  # A stream that would be saved short is not worth saving: a reader cannot tell a truncated history
  # from a quiet ticket. Fail the part, and name the knob when the knob is what stopped the read.
  if [ "$overbudget" = true ]; then
    PART_ERR="the page budget RIG_DISPATCH_MAX_PAGES=$MAX_PAGES ran out after $rows_total $stream rows with more retained; raise it to archive a long ticket"
    return 1
  fi
  if [ "$stalled" = true ]; then
    PART_ERR="the $stream cursor stopped after $pages page(s) with more retained rows, so the history would be incomplete"
    return 1
  fi
  jq -n --arg stream "$stream" --argjson pages "$pages" --arg status "$status" \
    --argjson stalled "$stalled" --arg watermark "$watermark" --argjson gapCount "$gapcount" \
    --slurpfile rows "$SCRATCH/rows.jsonl" --slurpfile gaps "$SCRATCH/gaps.jsonl" \
    '{stream: $stream, pages: $pages, coverageStatus: $status, stalled: $stalled,
      through: (if $watermark == "" then null else $watermark end),
      gapCount: $gapCount, rows: $rows, gaps: $gaps}'
}

# The mission-control audit rows have no CLI verb, so this is the daemon's own HTTP read over
# loopback with the bearer the entrypoint left for the CLI -- the same token, the same host check.
# `before_id` walks the rows backwards, 200 at a time. These rows are the only place a relayed human
# answer names the host it came from (auditNotes.openrig_relay.from_host), so they are archived whole.
read_audit() { # read_audit <slug> <qitem>
  local slug=$1 qitem=$2 before="" pages=0 stalled=false overbudget=false next rows_total=0
  : > "$SCRATCH/audit-rows.jsonl"
  while :; do
    if ! inpod "$slug" sh -c '
        tok=$(cat "${OPENRIG_HOME:-$HOME/.openrig}/terminal-token" 2>/dev/null)
        url="http://127.0.0.1:${OPENRIG_PORT:-7433}/api/mission-control/audit?qitem_id=$1&limit=$2"
        if [ -n "$3" ]; then url="$url&before_id=$3"; fi
        curl -fsS -H "Authorization: Bearer $tok" "$url"
      ' sh "$qitem" "$AUDIT_PAGE" "$before" >"$SCRATCH/page" 2>"$SCRATCH/page-err"; then
      PART_ERR=$(head -c 300 "$SCRATCH/page-err" | tr '\n\r' '  ')
      [ -n "$PART_ERR" ] || PART_ERR="the audit read failed"
      return 1
    fi
    if ! jq -e . "$SCRATCH/page" >/dev/null 2>&1; then
      PART_ERR="audit page $((pages + 1)) is not JSON: $(head -c 200 "$SCRATCH/page" | tr '\n\r' '  ')"; return 1
    fi
    jq -c '.rows[]?' "$SCRATCH/page" >> "$SCRATCH/audit-rows.jsonl"
    rows_total=$((rows_total + $(jq -c '(.rows // []) | length' "$SCRATCH/page")))
    pages=$((pages + 1))
    [ "$(jq -r '.hasMore' "$SCRATCH/page")" = true ] || break
    next=$(jq -r '.nextBeforeId // ""' "$SCRATCH/page")
    if [ -z "$next" ] || [ "$next" = "$before" ]; then stalled=true; break; fi
    before=$next
    [ "$pages" -lt "$MAX_PAGES" ] || { overbudget=true; break; }
  done
  if [ "$overbudget" = true ]; then
    PART_ERR="the page budget RIG_DISPATCH_MAX_PAGES=$MAX_PAGES ran out after $rows_total audit rows for $qitem with more retained; raise it to archive a long ticket"
    return 1
  fi
  if [ "$stalled" = true ]; then
    PART_ERR="the audit cursor for $qitem stopped after $pages page(s) with more rows, so the rows would be incomplete"
    return 1
  fi
  jq -n --arg q "$qitem" --argjson pages "$pages" --argjson stalled "$stalled" \
    --slurpfile rows "$SCRATCH/audit-rows.jsonl" \
    '{qitemId: $q, pages: $pages, stalled: $stalled, rows: $rows}'
}

# One seat's usage series, paged to the end. The public read answers at most 10,000 rows, oldest
# first, and says nothing when it truncates, so a long-running seat would quietly lose its NEWEST
# samples and the part would still claim success. `--since` walks forward from the last capturedAt
# seen; it is inclusive of that timestamp, so the rows are deduped by `id` at the end rather than
# counted per page. A page that cannot move the timestamp forward is a failure, not a short read.
read_usage() { # read_usage <slug> <seat>
  local slug=$1 seat=$2 since="" pages=0 n ts
  : > "$SCRATCH/usage-rows.jsonl"
  while :; do
    local -a args=(--seat "$seat" --limit "$USAGE_PAGE" --json)
    if [ -n "$since" ]; then args+=(--since "$since"); fi
    if ! inpod "$slug" rig usage series "${args[@]}" >"$SCRATCH/upage" 2>"$SCRATCH/upage-err"; then
      PART_ERR=$(head -c 300 "$SCRATCH/upage-err" | tr '\n\r' '  '); return 1
    fi
    if ! jq -e . "$SCRATCH/upage" >/dev/null 2>&1; then
      PART_ERR="usage page $((pages + 1)) is not JSON: $(head -c 200 "$SCRATCH/upage" | tr '\n\r' '  ')"; return 1
    fi
    jq -c '.rows[]?' "$SCRATCH/upage" >> "$SCRATCH/usage-rows.jsonl"
    pages=$((pages + 1))
    n=$(jq -c '(.rows // []) | length' "$SCRATCH/upage")
    if [ "$n" -lt "$USAGE_PAGE" ]; then break; fi
    ts=$(jq -r '[.rows[]?.capturedAt] | map(select(type == "string")) | max // ""' "$SCRATCH/upage")
    if [ -z "$ts" ] || [ "$ts" = "$since" ]; then
      PART_ERR="the usage series for $seat did not move past $ts at page $pages, so it could not be read to the end"
      return 1
    fi
    since=$ts
    if [ "$pages" -ge "$MAX_PAGES" ]; then
      PART_ERR="the page budget RIG_DISPATCH_MAX_PAGES=$MAX_PAGES ran out reading the usage series for $seat; raise it"
      return 1
    fi
  done
  jq -n --arg seat "$seat" --argjson pages "$pages" --slurpfile rows "$SCRATCH/usage-rows.jsonl" \
    '{seat: $seat, pages: $pages, rows: ($rows | unique_by(.id))}'
}

# Every queue row in the pod, with no 500-row ceiling: the daemon route passes the limit through and
# the CLI takes any positive integer, so the ceiling was always the dispatcher's own. Nothing is
# filtered by tag, because a team pod holds ONE ticket's database - which the events and transitions
# streams already assume - and a review or a human question the team opened itself carries no
# dispatcher tag, so filtering here would drop exactly the rounds and decisions report is asked for.
# The dispatcher's own item is named by the StatefulSet's `qitem` annotation, not by a filter.
ticket_queue() {
  local slug=$1
  inpod "$slug" rig queue list -a -A -o json --full --limit "$QUEUE_LIMIT"
}

# The high watermark a saved telemetry envelope recorded, or empty when the part is not there.
watermark_of() { if [ -f "$1" ]; then jq -r '.through // ""' "$1" 2>/dev/null || true; fi; }

cmd_archive() {
  local ticket="" dir=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dir) dir=$2; shift 2 ;;
      -*) die "unknown option $1" ;;
      *) [ -z "$ticket" ] || die "one ticket at a time"; ticket=$1; shift ;;
    esac
  done
  [ -n "$ticket" ] || usage
  local slug p rig root out old key qitem seat raw complete incarnation watermarks
  slug=$(slug_of "$ticket")
  p=$(probe "$slug")
  jq -e '.ready' >/dev/null <<<"$p" || die "$ticket: the team pod is not Ready, so there is nothing to archive"
  root=$(archive_root "$dir")
  key=$(jq -r '.ticket // empty' <<<"$p")
  rig=$(jq -r '.rig // empty' <<<"$p")
  mkdir -p "$root" || die "cannot create the archive root $root"
  out="$root/$slug"
  TMP=$(mktemp -d "$root/.${slug}.partial.XXXXXX") || die "cannot make a temporary directory in $root"
  trap '[ -n "${TMP:-}" ] && rm -rf "$TMP" || true' EXIT
  SCRATCH="$TMP/.scratch"; mkdir -p "$SCRATCH"
  PARTS='[]'

  save_part status "$TMP/status.json" printf '%s\n' "$p"
  save_part queue "$TMP/queue.json" ticket_queue "$slug"
  if [ -n "$rig" ]; then
    save_part nodes "$TMP/nodes.json" inpod "$slug" rig ps --nodes --rig "$rig" --json
  else
    part_failed nodes "the StatefulSet has no rig annotation, so the seats cannot be listed"
  fi

  for seat in $(jq -r '.seats[].session // empty' <<<"$p"); do
    save_part "usage:$seat" "$TMP/usage-$seat.json" read_usage "$slug" "$seat"
  done
  save_part usage-top "$TMP/usage-top.json" inpod "$slug" rig usage top --json

  save_part events "$TMP/events.json" read_telemetry "$slug" events
  save_part transitions "$TMP/queue-transitions.json" read_telemetry "$slug" transitions

  # One part per queue item: one item whose audit rows will not read costs that item's rows, not the
  # whole audit, and the manifest then names exactly which item it was.
  if [ -f "$TMP/queue.json" ]; then
    for qitem in $(jq -r '.[].qitemId // empty' "$TMP/queue.json"); do
      save_part "audit:$qitem" "$TMP/audit-$qitem.json" read_audit "$slug" "$qitem"
    done
  else
    part_failed audit "the queue part failed, so the ticket's queue items are unknown and no audit rows could be asked for"
  fi

  # The raw result.json, not only what the status probe read out of it. Absent is a state of the
  # ticket, not a failure of the archive, so it is a note rather than an error.
  if raw=$(inpod "$slug" sh -c "cat $RESULT 2>/dev/null || true"); then
    if [ -n "$raw" ]; then
      printf '%s\n' "$raw" > "$TMP/result.json"
      if jq -e . "$TMP/result.json" >/dev/null 2>&1; then part_ok result 1
      else part_ok result 1 "the pod's result.json is not valid JSON"; fi
    else
      part_ok result 0 "the pod has written no result.json yet"
    fi
  else
    part_failed result "could not read $RESULT from the pod"
  fi

  rm -rf "$SCRATCH"
  complete=$(jq -r 'if any(.[]; .ok | not) then "false" else "true" end' <<<"$PARTS")
  # Two facts the delete guard needs later: WHICH pod this archive describes (a re-dispatched ticket
  # reuses the slug) and how far the two streams had reached when it was read (a team that kept
  # working after this run has history this archive does not hold).
  incarnation=$(jq -r '.created // empty' <<<"$p")
  watermarks=$(jq -n --arg ev "$(watermark_of "$TMP/events.json")" --arg tr "$(watermark_of "$TMP/queue-transitions.json")" \
    '{events: (if $ev == "" then null else $ev end), transitions: (if $tr == "" then null else $tr end)}')
  jq -n --arg slug "$slug" --arg ticket "$key" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg dir "$out" --argjson parts "$PARTS" --argjson complete "$complete" \
    --arg inc "${incarnation:-}" --argjson wm "$watermarks" \
    '{slug: $slug, ticket: $ticket, archivedAt: $at, dir: $dir, complete: $complete,
      incarnation: (if $inc == "" then null else $inc end), watermarks: $wm, parts: $parts}' \
    > "$TMP/manifest.json" || die "could not write manifest.json in $TMP"

  # Swap the finished directory in. Two renames, so there is a moment with no $out, but a crash in
  # that moment leaves the complete previous archive at .<slug>.old: never half-old and half-new,
  # and never destroyed. A re-run replaces the whole directory, so nothing stale survives it.
  if [ -d "$out" ]; then
    old="$root/.${slug}.old.$$"
    mv "$out" "$old" || die "could not move the previous archive aside; nothing was changed"
    if ! mv "$TMP" "$out"; then
      mv "$old" "$out" || log "WARNING: the new archive did not land and the old one would not go back; it is at $old"
      die "could not move the new archive into $out; the previous archive is unchanged"
    fi
    rm -rf "$old"
  else
    mv "$TMP" "$out" || die "could not put the archive at $out"
  fi
  TMP=""

  jq -r '.parts[] | select(.ok) | "  saved \(.name): \(.rows // 0) rows"' "$out/manifest.json" >&2
  jq -r '.parts[] | select(.ok | not) | "  FAILED \(.name): \(.error)"' "$out/manifest.json" >&2
  log "archived $ticket in $out"
  [ "$complete" = true ] || return 1
}

# Fold one more part into a finished manifest and recompute completeness, so `collect` can report its
# bundle step in the same manifest as the parts the archive read. An empty error means the part is ok.
manifest_add() { # manifest_add <dir> <part> <error> [note] [rows]
  local dir=$1 name=$2 err=$3 note=${4:-} rows=${5:-1} tmp
  [ -f "$dir/manifest.json" ] || return 0
  tmp=$(mktemp "$dir/.manifest.XXXXXX") || return 0
  if jq --arg n "$name" --arg e "$err" --arg note "$note" --argjson r "$rows" \
      '.parts = (((.parts // []) | map(select(.name != $n)))
                 + [{name: $n, ok: ($e == ""), rows: $r}
                    + (if $e == "" then {} else {error: $e} end)
                    + (if $note == "" then {} else {note: $note} end)])
       | .complete = (((.parts | length) > 0) and (all(.parts[]; .ok)))' \
      "$dir/manifest.json" > "$tmp"; then
    mv "$tmp" "$dir/manifest.json"
  else
    rm -f "$tmp"
    log "WARNING: could not record the $name part in $dir/manifest.json"
    return 1
  fi
}

# collect = the archive, then the result branch. The order is the point: the history is saved first
# and stays saved even when the bundle step fails, because losing the history is the one failure here
# that cannot be undone and a missing bundle only costs the commits. A failed bundle is reported and
# makes collect exit non-zero; it never discards what was already archived.
cmd_collect() {
  local ticket="" archive="" into=""
  while [ $# -gt 0 ]; do
    case "$1" in --archive|--dir) archive=$2; shift 2 ;; --into) into=$2; shift 2 ;;
      -*) die "unknown option $1" ;; *) ticket=$1; shift ;; esac
  done
  [ -n "$ticket" ] || usage
  local slug root dir p branch bundle_err rc
  slug=$(slug_of "$ticket")
  root=$(archive_root "$archive")
  dir="$root/$slug"

  rc=0
  if [ -n "$archive" ]; then cmd_archive "$ticket" --dir "$archive" || rc=1
  else cmd_archive "$ticket" || rc=1; fi

  p=$(probe "$slug")
  branch=$(jq -r '.result.branch // empty' <<<"$p")
  bundle_err=""; bundle_note="nothing to bundle: the ticket has no result branch yet"; bundle_rows=0
  if [ -z "$branch" ]; then
    log "no result branch yet; the archive holds the history only"
  else
    bundle_note="branch $branch bundled"
    # Only the commits the remote does not have; the receiving clone has the rest.
    if inpod "$slug" env LC_ALL=C git -C "$WORK/project" bundle create - "$branch" --not --remotes \
         > "$dir/result.bundle" 2> "$dir/.bundle-err"; then
      bundle_rows=1
      if [ -n "$into" ]; then
        if git -C "$into" fetch --quiet "$(realpath "$dir/result.bundle")" "$branch:refs/tickets/$slug"; then
          log "fetched $branch into $into as refs/tickets/$slug"
        else
          bundle_err="the bundle was made but fetching it into $into failed; it is still at $dir/result.bundle"
        fi
      fi
    else
      bundle_err=$(head -c 300 "$dir/.bundle-err" | tr '\n\r' '  ')
      # A ticket that needed no commit has nothing to bundle. That is a state of the ticket, like an
      # absent result.json, so it is a note rather than a failure: an archive must not be made
      # incomplete by a ticket that finished cleanly, or `delete` would refuse it forever.
      case "$bundle_err" in
        *"empty bundle"*)
          bundle_note="branch $branch has no commit the remote does not already have, so there was nothing to bundle"
          bundle_err=""
          # git creates the file before it refuses, and a zero-byte result.bundle is exactly the
          # unusable part the delete guard would (rightly) refuse. Nothing was bundled, so nothing stays.
          rm -f "$dir/result.bundle" ;;
        *)
          [ -n "$bundle_err" ] || bundle_err="could not bundle branch $branch"
          bundle_note=""
          rm -f "$dir/result.bundle"
          ;;
      esac
    fi
    rm -f "$dir/.bundle-err"
  fi

  manifest_add "$dir" bundle "$bundle_err" "$bundle_note" "$bundle_rows" || rc=1
  if [ -n "$bundle_err" ]; then
    log "FAILED bundle: $bundle_err"
    log "the archive in $dir is kept: the history is safe, the commits are not"
    rc=1
  fi
  log "collected $ticket in $dir"
  [ "$rc" = 0 ] || return 1
}

# The stream's current high watermark, read with the cheap default page: `start=latest` returns the
# window and no rows, which is all the delete guard needs to know about whether the team wrote more.
live_watermark() { # live_watermark <slug> <events|transitions>
  inpod "$1" rig telemetry "$2" --json 2>/dev/null | jq -r '.page.retainedHighWatermark // empty' || true
}

# Is it safe to delete this ticket's pod? Three separate questions, all answered before anything is
# touched, because `delete` is the step that cannot be undone: is the archive COMPLETE (its manifest
# says so and no part failed), is it REAL (every part it claims was saved is on disk, parses, and
# holds the rows it claims), and is it CURRENT (it describes this pod, and this pod has not written
# history since). A complete archive of an earlier moment, or of an earlier team that used the same
# slug, answers none of the third. Prints the reason it is not safe, or nothing when it is.
archive_check() { # archive_check <root> <slug>
  local dir=$1/$2 bad missing complete name f want have sts live inc at moved wm want_wm have_wm
  if [ ! -f "$dir/manifest.json" ]; then
    printf 'there is no archive at %s (no manifest.json); run archive or collect first' "$dir"
    return 0
  fi
  bad=$(jq -r '[.parts[]? | select(.ok | not) | "\(.name) (\(.error // "failed"))"] | join("; ")' "$dir/manifest.json")
  missing=""
  while IFS=$'\t' read -r name want; do
    case "$name" in
      status) f=status.json ;;
      queue) f=queue.json ;;
      nodes) f=nodes.json ;;
      events) f=events.json ;;
      transitions) f=queue-transitions.json ;;
      result) f=result.json ;;
      usage-top) f=usage-top.json ;;
      usage:*) f="usage-${name#usage:}.json" ;;
      audit:*) f="audit-${name#audit:}.json" ;;
      bundle) f=result.bundle ;;
      *) f="" ;;
    esac
    [ -n "$f" ] || continue
    if [ ! -e "$dir/$f" ]; then
      # A part that saved nothing because there was nothing to save - no result.json yet, no branch to
      # bundle - is a state of the ticket, not a missing file.
      if [ -n "$want" ] && [ "$want" != 0 ]; then missing="$missing $name"; fi
      continue
    fi
    if [ "$f" = result.bundle ]; then
      [ -s "$dir/$f" ] || missing="$missing $name(empty)"
      continue
    fi
    # An empty or truncated file passes `[ -e ]` and is not an archived part.
    if ! jq -e . "$dir/$f" >/dev/null 2>&1; then missing="$missing $name(unreadable)"; continue; fi
    if [ -n "$want" ]; then
      have=$(rows_of "$dir/$f")
      [ "$have" = "$want" ] || missing="$missing $name(has $have rows, the manifest says $want)"
    fi
  done < <(jq -r '.parts[]? | select(.ok) | [.name, (.rows // "")] | @tsv' "$dir/manifest.json")
  complete=$(jq -r '.complete // false' "$dir/manifest.json")
  if [ -z "$bad" ] && [ -z "$missing" ] && [ "$complete" = true ]; then
    sts=$(sts_json "$2" 2>/dev/null || true)
    if [ -n "$sts" ]; then
      inc=$(jq -r '.incarnation // empty' "$dir/manifest.json")
      live=$(jq -r '.metadata.creationTimestamp // empty' <<<"$sts")
      if [ -n "$live" ] && [ -n "$inc" ] && [ "$inc" != "$live" ]; then
        printf 'the archive at %s describes a different incarnation of this ticket (archived %s; the pod running now was created %s); archive again' "$dir" "$inc" "$live"
        return 0
      fi
      moved=""
      for wm in events transitions; do
        want_wm=$(jq -r ".watermarks.$wm // empty" "$dir/manifest.json")
        [ -n "$want_wm" ] || continue
        have_wm=$(live_watermark "$2" "$wm")
        if [ -z "$have_wm" ]; then moved="$moved $wm(cannot be read now)"; continue; fi
        [ "$have_wm" = "$want_wm" ] || moved="$moved $wm"
      done
      if [ -n "$moved" ]; then
        printf 'the team has moved on since the archive at %s was taken (%s); archive again' "$dir" "${moved# }"
        return 0
      fi
    fi
    return 0
  fi
  printf 'the archive at %s is not complete' "$dir"
  if [ -n "$bad" ]; then printf '; parts that failed: %s' "$bad"; fi
  if [ -n "$missing" ]; then printf '; parts the manifest says were saved but are not usable on disk:%s' "$missing"; fi
  if [ -z "$bad" ] && [ -z "$missing" ]; then printf '; its manifest does not say complete'; fi
}

# --- report ----------------------------------------------------------------------------------
#
# Everything here is computed from the archive directory alone -- that is the point of the archive --
# so what a part could not read is simply absent from the figures rather than guessed. The definitions
# are stated in the README and repeated in the footer of the table, because a figure nobody can check
# is not a figure. Each one says what it cannot tell.
#
#   duration        first to last archived event timestamp. Not the pod's lifetime: nothing before the
#                   first event and nothing the event stream did not record is in here, and if the
#                   archive reports coverage gaps the duration is a floor, not a total.
#   reviewRounds    how many of the ticket's queue items were addressed to a review seat, ignoring the
#                   stuck-sweep recovery rows that are addressed to a review seat for a different
#                   reason. A review that found nothing still counts as a round; a review done inside
#                   one seat's own turn without a queue item is invisible here.
#   handoffs        how many archived queue transitions closed a handoff: `handoff` closes with state
#                   handed-off, while `handoff-and-complete` and a plain close with a handed_off_to
#                   reason close with state done and that reason, so counting the state alone misses
#                   two of the three ways a handoff is recorded. Handoffs made outside the queue are
#                   not counted, because there is no record of them.
#   humanDecisions  how many archived audit rows are a resolve, with the actor and, for an answer that
#                   came through a hub, the host it came from (auditNotes.openrig_relay.from_host).
#                   That host is present only for a relayed answer: an answer typed inside the team's
#                   own pod records no origin host, and report says so rather than inventing one.
#   usage           the sum of positive per-node token deltas across the archived usage samples, which
#                   is the same rule the daemon's own top-burn uses. These are periodic samples of
#                   cumulative counters, NOT exact token accounting: a restart resets a counter (those
#                   are counted as resets, never as negative burn), and a quiet stretch between two
#                   samples is invisible. usage-top is a snapshot of the last hour before the archive
#                   ran, so it is labelled as a window and never added to the total.
REPORT_JQ='
def ts: if (type == "string") then ((.[0:19] + "Z") | fromdate) else null end;
def is_recovery: ((.tags // []) | index("stuck-sweep-finding")) != null or ((.qitemId // "") | startswith("qitem-recovery-"));
def span($a; $b): if (($a | ts) != null and ($b | ts) != null) then (($b | ts) - ($a | ts)) else null end;
def hm: if . == null then "-" elif . < 60 then "\(.)s" elif . < 3600 then "\((./60 | floor))m" else "\((./3600 | floor))h\((((. % 3600) / 60) | floor))m" end;
def tokdelta($rows):
  ($rows | map(select(.lane == "context"))) as $ctx
  | ($ctx | group_by(.nodeId)
     | map(sort_by(.capturedAt)
           | reduce .[] as $r ({prev: null, delta: 0, resets: 0};
               if (($r.totalInputTokens == null) or ($r.totalOutputTokens == null)) then .
               else ($r.totalInputTokens + $r.totalOutputTokens) as $cur
                 | if .prev == null then {prev: $cur, delta: .delta, resets: .resets}
                   elif ($cur - .prev) >= 0 then {prev: $cur, delta: (.delta + $cur - .prev), resets: .resets}
                   else {prev: $cur, delta: .delta, resets: (.resets + 1)} end
               end)
           | {delta: .delta, resets: .resets})
     | {tokens: (map(.delta) | add // 0), resets: (map(.resets) | add // 0), samples: ($ctx | length)});
{
  slug: $slug,
  ticket: ($m[0].ticket // null),
  archivedAt: ($m[0].archivedAt // null),
  archiveComplete: ($m[0].complete // false),
  partsFailed: [$m[0].parts[]? | select(.ok | not) | .name],
  events: ($ev.rows | length),
  firstEvent: ($ev.rows | map(.createdAt) | map(select(type == "string")) | first),
  lastEvent: ($ev.rows | map(.createdAt) | map(select(type == "string")) | last),
  coverageGaps: ($ev.gaps | length),
  historyMayBePartial: (($ev.stalled // false) or (($ev.gaps | length) > 0)),
  transitions: ($tr.rows | length),
  handoffs: ([$tr.rows[]? | select(.state == "handed-off" or .closureReason == "handed_off_to")] | length),
  reviewRounds: ([$qu[]? | select((.destinationSession // "") | startswith("review")) | select(is_recovery | not)] | length),
  reviewItems: [$qu[]? | select((.destinationSession // "") | startswith("review")) | select(is_recovery | not) | .qitemId],
  humanDecisions: ([$au.rows[]? | select(.actionVerb == "resolve")] | length),
  decisions: [$au.rows[]? | select(.actionVerb == "resolve")
              | {at: (.actedAt // null), actor: (.actorSession // null),
                 fromHost: (((.auditNotes // {}) | (.openrig_relay // {})) | .from_host // null),
                 decision: (.reason // null)}],
  usage: {
    seats: [$usage[] | {seat: .seat} + tokdelta(.rows)],
    tokens: (reduce ($usage[] | {seat: .seat} + tokdelta(.rows)) as $s (0; . + $s.tokens)),
    resets: (reduce ($usage[] | {seat: .seat} + tokdelta(.rows)) as $s (0; . + $s.resets)),
    samples: (reduce ($usage[] | {seat: .seat} + tokdelta(.rows)) as $s (0; . + $s.samples)),
    topWindowHours: ($utop.windowHours // null),
    topRankedSeats: ($utop.totalRankedSeats // null),
    topUnknownSeats: ([$utop.unknown[]?] | length)
  }
}
| .durationSeconds = span(.firstEvent; .lastEvent)
| .duration = (.durationSeconds | hm)
'

load_or() { # load_or <file> <fallback-json>
  if [ -f "$1" ] && jq -e . "$1" >/dev/null 2>&1; then cat "$1"; else printf '%s' "$2"; fi
}

# One ticket's figures, or non-zero when there is no archive to report from.
report_one() { # report_one <root> <slug>
  local dir=$1/$2 ev tr qu au utop usage f
  [ -f "$dir/manifest.json" ] || return 1
  ev=$(load_or "$dir/events.json" '{rows: [], gaps: [], stalled: false}')
  tr=$(load_or "$dir/queue-transitions.json" '{rows: []}')
  qu=$(load_or "$dir/queue.json" '[]')
  utop=$(load_or "$dir/usage-top.json" '{}')
  au='{"rows": []}'
  for f in "$dir"/audit-*.json; do
    [ -e "$f" ] || continue
    au=$(jq -c --slurpfile a "$f" '{rows: (.rows + ($a[0].rows // []))}' <<<"$au") || return 1
  done
  usage='[]'
  for f in "$dir"/usage-*.json; do
    [ -e "$f" ] || continue
    case "$f" in */usage-top.json) continue ;; esac
    usage=$(jq -c --arg s "$(basename "$f" .json | sed 's/^usage-//')" --slurpfile u "$f" \
      '. + [{seat: $s, rows: ($u[0].rows // [])}]' <<<"$usage") || return 1
  done
  jq -n --arg slug "$2" --slurpfile m "$dir/manifest.json" \
    --argjson ev "$ev" --argjson tr "$tr" --argjson qu "$qu" --argjson au "$au" \
    --argjson utop "$utop" --argjson usage "$usage" "$REPORT_JQ"
}

cmd_report() {
  local json=0 all=0 dir="" ticket="" d
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      --all) all=1; shift ;;
      --dir) dir=$2; shift 2 ;;
      -*) die "unknown option $1" ;;
      *) [ -z "$ticket" ] || die "one ticket at a time"; ticket=$1; shift ;;
    esac
  done
  if [ -z "$ticket" ] && [ $all = 0 ]; then usage; fi
  local root out='[]' s r found=0
  root=$(archive_root "$dir")
  local -a slugs=()
  if [ $all = 1 ]; then
    for d in "$root"/*/; do
      [ -f "${d}manifest.json" ] || continue
      slugs+=("$(basename "$d")")
    done
    if [ "${#slugs[@]}" = 0 ]; then die "no archived tickets under $root"; fi
  else
    slugs=("$(slug_of "$ticket")")
  fi
  for s in "${slugs[@]}"; do
    if r=$(report_one "$root" "$s"); then
      found=1
      out=$(jq -c --argjson r "$r" '. + [$r]' <<<"$out")
    else
      if [ $all = 1 ]; then log "no archive for $s under $root, skipped"
      else die "no archive for $s under $root; run archive or collect first"; fi
    fi
  done
  [ $found = 1 ] || die "nothing to report under $root"
  if [ $json = 1 ]; then
    if [ $all = 1 ]; then jq . <<<"$out"; else jq '.[0]' <<<"$out"; fi
    return 0
  fi
  jq -r '
    (["TICKET", "DURATION", "EVENTS", "ROUNDS", "HANDOFFS", "DECISIONS", "TOKENS", "ARCHIVE"] | @tsv),
    (.[] | [(.ticket // .slug), .duration, (.events | tostring), (.reviewRounds | tostring),
            (.handoffs | tostring), (.humanDecisions | tostring), (.usage.tokens | tostring),
            (if .archiveComplete then "complete" else "INCOMPLETE" end)] | @tsv)' <<<"$out" |
    column -t -s $'\t'
  jq -r '.[] | (.ticket // .slug) as $t | (.decisions[] |
    "\($t): decided by \(.actor // "?") at \(.at // "?") \(if .fromHost then "from host \(.fromHost)" else "(no relay host recorded)" end)")' \
    <<<"$out"
  jq -r '.[] | select(.historyMayBePartial) |
    "\(.ticket // .slug): the archived history reports gaps or a stalled read, so duration and counts are a floor"' \
    <<<"$out"
  echo "  duration = first to last archived event; tokens = sampled cumulative counters, not exact accounting"
}

# `kubectl exec` appends "command terminated with exit code N" to its own stderr, and the answer path
# captures both streams together, so a hub error arrives as one line of JSON plus a line of kubectl
# noise. Parsing the whole blob with jq fails on the noise, which would make a real refusal look like an
# unparsable failure. Pick the last line that is a JSON object.
json_last() { printf '%s\n' "$1" | jq -Rc 'fromjson? | select(type == "object")' 2>/dev/null | tail -1; }

# Did the hub's write actually reach the team? The row's own state cannot say so - anything that unparks
# a row looks the same. The team's audit rows can: a relayed resolve carries the decision text in
# `reason` and the hub that forwarded it in auditNotes.openrig_relay.from_host. One page of the same
# loopback read the archive uses; the newest rows come first, so a resolve this dispatcher just asked
# for is in it or the write is not confirmed.
answer_confirmed() { # answer_confirmed <slug> <qitem> <decision>
  inpod "$1" sh -c '
    tok=$(cat "${OPENRIG_HOME:-$HOME/.openrig}/terminal-token" 2>/dev/null)
    curl -fsS -H "Authorization: Bearer $tok" \
      "http://127.0.0.1:${OPENRIG_PORT:-7433}/api/mission-control/audit?qitem_id=$1&limit=$2"
  ' sh "$2" "$AUDIT_PAGE" 2>/dev/null |
    jq -e --arg d "$3" 'any(.rows[]?; .actionVerb == "resolve" and .reason == $d
      and ((.auditNotes.openrig_relay.from_host // "") != ""))' >/dev/null 2>&1
}

# Answer a parked ticket's queue item.
#
# The hub first, because the hub runs the code that records a human truthfully: forwarded with a hostId,
# the origin team daemon stores the actor as the human and stamps auditNotes.openrig_relay.from_host with
# the hub's own host id, so the archive can later say who answered and from where. Resolving inside the
# team pod instead records the team's lead session as the resolver, which is a seat, and a seat is not who
# answered.
#
# No seat environment is set for the hub call, on purpose. `rig queue resolve` with no seat sends its own
# seatless human actor in the request body and the team records that at the provenance the CLI itself
# claims for it. Setting OPENRIG_SESSION_NAME would send a header instead, which the hub treats as
# transport-proven and the team downgrades to relay:v1 - a strength nothing here verified. Naming an
# individual human needs the hub's own human registry, which is a later step; until then every answer is
# recorded as the seatless human actor.
#
# The fallback is for the hub being unable to answer, never for the team refusing. A write the team itself
# rejected comes back as remote_action_failed with failureClass remote-error, and re-issuing that inside the
# pod would bury the team's reason under a seat's name. Every other failure means the hub could not do it -
# and three of them (a request timeout, a body that timed out after the headers arrived, a network failure
# the forwarder itself calls indeterminate) can happen after the team already took the write, so the row is
# read in the pod first, and the team's own audit rows decide whether the hub's write is confirmed.

cmd_answer() {
  [ $# -ge 3 ] || usage
  local ticket=$1 qitem=$2; shift 2
  local decision="$*"
  local slug host out rc fc err body row state blocked
  slug=$(slug_of "$ticket")
  # The same id `start` registered, never a guess.
  host=$(name_of "$slug")

  if ! hub_ready; then
    log "answer: no Ready hub pod $HUB_POD, so this cannot be recorded as a human answer; falling back to the team pod"
  elif ! hub_registry has "$host" >/dev/null 2>&1; then
    log "answer: team host $host is not registered on $HUB_POD, so the hub cannot forward to it; falling back to the team pod"
  else
    rc=0
    out=$(hub_exec env -u OPENRIG_SESSION_NAME -u RIGGED_SESSION_NAME rig queue resolve --host "$host" \
      "$qitem" --decision "$decision" --json 2>&1 </dev/null) || rc=$?
    if [ "$rc" = 0 ]; then
      log "answer: resolved on $host through $HUB_POD as the seatless human, so the audit row names the human and the origin host"
      printf '%s\n' "$out"
      return 0
    fi
    body=$(json_last "$out")
    fc=$(printf '%s' "$body" | jq -r '.failureClass // empty' 2>/dev/null || true)
    err=$(printf '%s' "$body" | jq -r '.error // empty' 2>/dev/null || true)
    if [ "$err" = "remote_action_failed" ] && [ "$fc" = "remote-error" ]; then
      printf '%s\n' "$out" >&2
      die "answer: $HUB_POD delivered the answer to $host and the team refused it (exit $rc). Not falling back: resolving it inside the pod would only bury the team's own reason."
    fi
    log "answer: $HUB_POD could not record the answer${fc:+ ($fc)}; reading the team's own copy before falling back"
    row=$(inpod "$slug" rig queue show "$qitem" --json 2>/dev/null || true)
    state=$(printf '%s' "$row" | jq -r '.state // empty' 2>/dev/null || true)
    blocked=$(printf '%s' "$row" | jq -r '.blockedOn // empty' 2>/dev/null || true)
    if [ -z "$row" ] || [ -z "$state" ] || { [ "$state" = "blocked" ] && [ -z "$blocked" ]; }; then
      # Nothing was learned about the row. A pod that cannot be read is also the usual cause of an
      # `unreachable` hub failure, so this is exactly where claiming a landing would be wrong.
      printf '%s\n' "$out" >&2
      log "answer: cannot read $qitem on $host, so the answer is not confirmed; the hub reported ${err:-an error}${fc:+/$fc}. Check the team pod before answering again."
      return 5
    fi
    if [ "$state" != "blocked" ]; then
      # The row is not parked, which is not the same as the human's answer having been recorded. The
      # team's audit rows decide it; a row moved by anything else is not a landing.
      if answer_confirmed "$slug" "$qitem" "$decision"; then
        log "answer: the hub's answer landed on $host; its audit row carries the decision from $HUB_POD, so nothing is re-issued"
        printf '%s\n' "$out"
        return 0
      fi
      printf '%s\n' "$out" >&2
      case "$fc" in
        unreachable)
          log "answer: $qitem is now '${state}' and not parked on a human, but no audit row on $host carries this decision, so the hub's write is not confirmed (it reported ${fc})" ;;
        *)
          log "answer: $qitem is now '${state}' and not parked on a human, but no audit row on $host carries this decision; $HUB_POD reported ${err:-an error}${fc:+/$fc} and this dispatcher cannot tell whether that write landed" ;;
      esac
      return 5
    fi
    log "answer: $qitem is still blocked on $blocked, so the hub's write never reached it; falling back to the team pod"
  fi

  # The old path, kept for the cases above. It records the team's lead as the resolver because a bare
  # exec shell has no human identity to offer the team's own daemon.
  local sts rig lead session
  sts=$(sts_json "$slug") || die "$ticket has no team"
  rig=$(annotation "$sts" rig)
  lead=$(annotation "$sts" lead || true); [ -n "$lead" ] || lead=orch.lead
  session=$(lead_session "$slug" "$rig" "$lead")
  [ -n "$session" ] || die "no seat '$lead' in rig $rig; cannot answer as a seat"
  log "answer: resolving inside the team pod as $session; the audit row will name that seat, not the human"
  inpod "$slug" env OPENRIG_SESSION_NAME="$session" rig queue resolve "$qitem" --decision "$decision" --json
}

# --- collect / answer / delete ---------------------------------------------------------------

cmd_delete() {
  local ticket="" force=0 dir=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1; shift ;;
      --dir) dir=$2; shift 2 ;;
      -*) die "unknown option $1" ;;
      *) [ -z "$ticket" ] || die "one ticket at a time"; ticket=$1; shift ;;
    esac
  done
  [ -n "$ticket" ] || usage
  local slug sts rig name reason
  slug=$(slug_of "$ticket"); name=$(name_of "$slug")
  # The guard runs before anything is touched, so a refused delete leaves the team, its hub entry and
  # its volume exactly as they were.
  reason=$(archive_check "$(archive_root "$dir")" "$slug")
  if [ -n "$reason" ]; then
    if [ "$force" = 1 ]; then
      log "WARNING: deleting without a complete archive: $reason"
    else
      die "$ticket: $reason. Use --force to delete anyway."
    fi
  fi
  sts=$(sts_json "$slug" || true)
  # Unregister before the pod goes, so the hub never keeps a host it can no longer reach.
  hub_unregister "$slug"
  if [ -n "$sts" ]; then
    rig=$(annotation "$sts" rig)
    if [ -n "$rig" ] && k get pod "$(pod_of "$slug")" >/dev/null 2>&1; then
      inpod "$slug" rig down "$rig" >/dev/null 2>&1 || log "rig down failed; deleting anyway"
    fi
    k delete statefulset "$name" --wait=true >/dev/null
  fi
  k delete secret "$name" --ignore-not-found >/dev/null
  # whenDeleted: Delete removes the volume; this covers a StatefulSet deleted by other means.
  k delete pvc -l "$ANN/ticket=$slug" --ignore-not-found >/dev/null
  k delete pvc "home-$name-0" --ignore-not-found >/dev/null
  # The resume store is keyed by ticket key, and the ticket instance dies here. Leaving the id behind
  # is what makes a re-dispatched ticket key start out watching a stream that will stay silent for
  # ever, so the file goes with the pod it described.
  rm -f "$(watch_file "$slug")" 2>/dev/null || true
  log "deleted $name"
}

# The dispatch block runs only when this file is executed. Sourcing it defines the helpers and stops
# here, which is what lets a test reach `hub_register`, `sync_plan` and the rest without the file
# immediately running a command -- and without `usage` exiting 2 over the head of whoever sourced it.
if [ "${BASH_SOURCE[0]:-}" = "$0" ]; then
  [ $# -ge 1 ] || usage
  cmd=$1; shift
  case "$cmd" in
    start) cmd_start "$@" ;;
    status|ls) cmd_status "$@" ;;
    wait) cmd_wait "$@" ;;
    watch) cmd_watch "$@" ;;
    archive) cmd_archive "$@" ;;
    collect) cmd_collect "$@" ;;
    report) cmd_report "$@" ;;
    answer) cmd_answer "$@" ;;
    delete|rm) cmd_delete "$@" ;;
    hub-sync) cmd_hub_sync "$@" ;;
    -h|--help|help) usage ;;
    *) die "unknown command $cmd" ;;
  esac
fi
