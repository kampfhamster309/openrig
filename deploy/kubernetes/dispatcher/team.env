# Environment every team pod gets, as NAME=VALUE lines; --env adds to it per ticket.
# Provider credentials come from the openrig-agents Secret (envFrom); seats see them only when named here.
OPENRIG_RECOVERY_PROVIDER_AUTH_ENV_ALLOWLIST=CLAUDE_CODE_OAUTH_TOKEN
# Pi seats of the kit's rig whose agent dir the entrypoint seeds.
OPENRIG_PI_SEATS=dev-build@claude-pi-k8s
